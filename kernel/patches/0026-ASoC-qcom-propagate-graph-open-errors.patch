From: SP11 audio worker <audio-worker@localhost>
Subject: [PATCH candidate] ASoC: qcom: propagate graph OPEN failures

The APM graph OPEN result is discarded, so a rejected or timed out DSP
command can be followed by a successful host graph allocation. Serialize
shared graph lookup, opening and final release, and propagate the result
before another user can acquire the graph. Log the graph ID and result.

A timeout leaves DSP state uncertain; do not automatically retry a device
test after one. This affects all AudioReach graphs and needs integration
review, including shared graph and failure-path concurrency testing.

---
--- a/sound/soc/qcom/qdsp6/q6apm.h
+++ b/sound/soc/qcom/qdsp6/q6apm.h
@@ -60,6 +60,8 @@
 
 	struct mutex cmd_lock;
 	struct mutex lock;
+	/* Serialize shared graph lookup, opening and final release. */
+	struct mutex graph_lock;
 	uint32_t state;
 
 	struct list_head widget_list;
--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -43,54 +43,67 @@
 {
 	struct audioreach_graph_info *info;
 	struct audioreach_graph *graph;
-	int id;
-
+	int ret;
+
+	/* Do not expose an unacknowledged graph or race its last reference. */
+	mutex_lock(&apm->graph_lock);
 	mutex_lock(&apm->lock);
 	graph = idr_find(&apm->graph_idr, graph_id);
 	mutex_unlock(&apm->lock);
-
 	if (graph) {
 		kref_get(&graph->refcount);
-		return graph;
+		goto out;
 	}
 
 	info = idr_find(&apm->graph_info_idr, graph_id);
-
-	if (!info)
-		return ERR_PTR(-ENODEV);
+	if (!info) {
+		ret = -ENODEV;
+		goto fail;
+	}
 
 	graph = kzalloc_obj(*graph);
-	if (!graph)
-		return ERR_PTR(-ENOMEM);
+	if (!graph) {
+		ret = -ENOMEM;
+		goto fail;
+	}
 
 	graph->apm = apm;
 	graph->info = info;
 	graph->id = graph_id;
-
 	graph->graph = audioreach_alloc_graph_pkt(apm, info);
 	if (IS_ERR(graph->graph)) {
-		void *err = graph->graph;
-
-		kfree(graph);
-		return ERR_CAST(err);
-	}
+		ret = PTR_ERR(graph->graph);
+		goto free_graph;
+	}
+	kref_init(&graph->refcount);
 
 	mutex_lock(&apm->lock);
-	id = idr_alloc(&apm->graph_idr, graph, graph_id, graph_id + 1, GFP_KERNEL);
-	if (id < 0) {
-		dev_err(apm->dev, "Unable to allocate graph id (%d)\n", graph_id);
-		kfree(graph->graph);
-		kfree(graph);
+	ret = idr_alloc(&apm->graph_idr, graph, graph_id, graph_id + 1, GFP_KERNEL);
+	mutex_unlock(&apm->lock);
+	if (ret < 0) {
+		dev_err(apm->dev, "Unable to allocate graph id (%u): %d\n", graph_id, ret);
+		goto free_packet;
+	}
+
+	ret = q6apm_send_cmd_sync(apm, graph->graph, 0);
+	dev_info(apm->dev, "graph %u OPEN rc=%d\n", graph_id, ret);
+	if (ret) {
+		mutex_lock(&apm->lock);
+		idr_remove(&apm->graph_idr, graph_id);
 		mutex_unlock(&apm->lock);
-		return ERR_PTR(id);
-	}
-	mutex_unlock(&apm->lock);
-
-	kref_init(&graph->refcount);
-
-	q6apm_send_cmd_sync(apm, graph->graph, 0);
-
+		goto free_packet;
+	}
+out:
+	mutex_unlock(&apm->graph_lock);
 	return graph;
+
+free_packet:
+	kfree(graph->graph);
+free_graph:
+	kfree(graph);
+fail:
+	mutex_unlock(&apm->graph_lock);
+	return ERR_PTR(ret);
 }
 
 static int audioreach_graph_mgmt_cmd(struct audioreach_graph *graph, uint32_t opcode)
@@ -140,6 +153,14 @@
 	kfree(graph);
 }
 
+static void q6apm_put_graph_ref(struct audioreach_graph *graph)
+{
+	struct q6apm *apm = graph->apm;
+
+	mutex_lock(&apm->graph_lock);
+	kref_put(&graph->refcount, q6apm_put_audioreach_graph);
+	mutex_unlock(&apm->graph_lock);
+}
 
 static int q6apm_get_apm_state(struct q6apm *apm)
 {
@@ -786,7 +807,7 @@
 free_graph:
 	kfree(graph);
 put_ar_graph:
-	kref_put(&ar_graph->refcount, q6apm_put_audioreach_graph);
+	q6apm_put_graph_ref(ar_graph);
 	return ERR_PTR(ret);
 }
 EXPORT_SYMBOL_GPL(q6apm_graph_open);
@@ -798,7 +819,7 @@
 	if (q6apm_find_module_by_mid(graph, MODULE_ID_SPEAKER_PROTECTION_VI))
 		sp11_guard_vi_closed(ar_graph);
 	graph->ar_graph = NULL;
-	kref_put(&ar_graph->refcount, q6apm_put_audioreach_graph);
+	q6apm_put_graph_ref(ar_graph);
 	gpr_free_port(graph->port);
 	kfree(graph);
 
@@ -893,6 +914,7 @@
 		return -ENOMEM;
 
 	mutex_init(&apm->lock);
+	mutex_init(&apm->graph_lock);
 	apm->dev = dev;
 	apm->gdev = gdev;
 	init_waitqueue_head(&apm->wait);
