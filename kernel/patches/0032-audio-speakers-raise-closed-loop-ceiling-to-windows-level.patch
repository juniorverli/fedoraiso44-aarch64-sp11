From 52ad3c3d659c208f5a8b643cb0715e92ab231b05 Mon Sep 17 00:00:00 2001
From: Audio speakers <audio-speakers@localhost>
Date: Sat, 7 Nov 2026 18:55:40 +0000
Subject: [PATCH] ASoC: qcom: raise the speaker ceiling only in closed-loop
 mode

The Surface Pro 11 speakers are quiet because the D26/open-loop caps keep
the WSA RX/RX_MIX digital volume at -3 dB and the WSA884x PA at 0 dB. When
the closed-loop speaker protection topology is parsed and the guard selects
SP11_MODE_CLOSED_LOOP, the Windows endpoint runs at 0 dBFS digital and a
+16.5 dB analog PA target.

Expose the parsed mode through sp11_guard_closed_loop() and install the
Windows-equivalent caps (WSA RX/RX_MIX 84 = 0 dB, PA 17 = +16.5 dB) only in
that mode. An unknown, refused or open-loop mode keeps 81/6 exactly as
before. The accessor is read-only; every unmute still goes through
sp11_guard_unmute_check(), so the higher ceiling cannot produce sound
before the SP module, the V/I stream and the calibration are running.

Assisted-by: Claude Code
Signed-off-by: Audio speakers <audio-speakers@localhost>
---
 include/sound/sp11-guard.h  |  8 ++++++++
 sound/soc/qcom/sp11-guard.c | 20 ++++++++++++++++++++
 sound/soc/qcom/x1e80100.c   | 32 +++++++++++++++++++++++++++++---
 3 files changed, 57 insertions(+), 3 deletions(-)

diff --git a/include/sound/sp11-guard.h b/include/sound/sp11-guard.h
index 480b5ab59..b34bb2185 100644
--- a/include/sound/sp11-guard.h
+++ b/include/sound/sp11-guard.h
@@ -60,6 +60,13 @@ int sp11_guard_check(struct device *dev);
 int sp11_guard_unmute_check(struct device *dev);
 bool sp11_guard_faulted(void);
 bool sp11_guard_nospk(void);
+/*
+ * True only when the parsed topology is the closed-loop SP+VI topology.
+ * The machine driver uses it to pick the closed-loop speaker ceiling; it
+ * never allows output by itself, every unmute still goes through
+ * sp11_guard_unmute_check().
+ */
+bool sp11_guard_closed_loop(void);
 #else
 static inline int sp11_guard_select_mode(bool marker_valid, bool has_sp) { return -EOPNOTSUPP; }
 static inline void sp11_guard_caps_ready(bool ready) { }
@@ -82,6 +89,7 @@ static inline void sp11_guard_set_mute(void (*mute)(void *data), void *data) { }
 static inline void sp11_guard_clear_mute(void *data) { }
 static inline bool sp11_guard_faulted(void) { return true; }
 static inline bool sp11_guard_nospk(void) { return true; }
+static inline bool sp11_guard_closed_loop(void) { return false; }
 /* Without the guard the speakers are never allowed */
 static inline int sp11_guard_check(struct device *dev) { return -EOPNOTSUPP; }
 static inline int sp11_guard_unmute_check(struct device *dev) { return -EOPNOTSUPP; }
diff --git a/sound/soc/qcom/sp11-guard.c b/sound/soc/qcom/sp11-guard.c
index 4b9bd44b4..29d40602e 100644
--- a/sound/soc/qcom/sp11-guard.c
+++ b/sound/soc/qcom/sp11-guard.c
@@ -129,6 +129,26 @@ void sp11_guard_caps_ready(bool ready)
 }
 EXPORT_SYMBOL_GPL(sp11_guard_caps_ready);
 
+/*
+ * The parsed topology is the only source of the mode; it is selected in the
+ * q6apm component probe, before the card late probe installs the caps. A
+ * refused or failed topology parse leaves the mode unknown, which reads as
+ * false here, so the D26/open-loop ceiling stays in place. This is a
+ * read-only view for the machine driver and does not bypass any gate.
+ */
+bool sp11_guard_closed_loop(void)
+{
+	unsigned long flags;
+	bool closed;
+
+	spin_lock_irqsave(&guard.lock, flags);
+	closed = guard.mode == SP11_MODE_CLOSED_LOOP;
+	spin_unlock_irqrestore(&guard.lock, flags);
+
+	return closed;
+}
+EXPORT_SYMBOL_GPL(sp11_guard_closed_loop);
+
 static const char *sp11_guard_open_reason(void)
 {
 	if (guard.mode == SP11_MODE_UNKNOWN || guard.mode == SP11_MODE_REFUSED)
diff --git a/sound/soc/qcom/x1e80100.c b/sound/soc/qcom/x1e80100.c
index b1c9f9c3b..5f9e17381 100644
--- a/sound/soc/qcom/x1e80100.c
+++ b/sound/soc/qcom/x1e80100.c
@@ -49,6 +49,26 @@ static int x1e80100_limit_volume(struct snd_soc_card *card, const char *name,
 	return 0;
 }
 
+/*
+ * Speaker volume ceilings.
+ *
+ * - D26/open-loop (no parsed SP+VI topology) keeps the safe values this
+ *   machine has always used: WSA RX/RX_MIX 81 (-3 dB) and PA 6 (0 dB).
+ * - Closed-loop (the topology parse found the SP module and selected the
+ *   closed-loop mode) uses the Windows endpoint values recovered from
+ *   surface_audiominiext8380.inf (WaveSpeaker MaxEpVolume 0 dBFS) and
+ *   acdb_cal_0D.acdb (target analog PA gain +16.5 dB): WSA RX/RX_MIX 84
+ *   (0 dB) and PA 17 (+16.5 dB, 1.5 dB per step from -9 dB).
+ *
+ * The mode is selected by audioreach_sp11_policy() in the q6apm component
+ * probe, which runs before the card late probe that installs these caps. An
+ * unknown, refused or open-loop mode therefore keeps the D26 values.
+ */
+#define SP11_D26_DIGITAL_MAX	81	/* -3 dB */
+#define SP11_D26_PA_MAX		6	/* 0 dB */
+#define SP11_CL_DIGITAL_MAX	84	/* 0 dB */
+#define SP11_CL_PA_MAX		17	/* +16.5 dB */
+
 static int x1e80100_install_spk_caps(struct snd_soc_card *card)
 {
 	static const char * const required[] = {
@@ -69,25 +89,29 @@ static int x1e80100_install_spk_caps(struct snd_soc_card *card)
 		"WooferRight PA Volume",
 		"TweeterRight PA Volume",
 	};
+	bool closed_loop = sp11_guard_closed_loop();
+	int digital_max = closed_loop ? SP11_CL_DIGITAL_MAX : SP11_D26_DIGITAL_MAX;
+	int pa_max = closed_loop ? SP11_CL_PA_MAX : SP11_D26_PA_MAX;
 	int i, ret;
 
 	sp11_guard_caps_ready(false);
 	for (i = 0; i < ARRAY_SIZE(required); i++) {
 		ret = x1e80100_limit_volume(card, required[i],
-					    strstr(required[i], "PA Volume") ? 6 : 81,
+					    strstr(required[i], "PA Volume") ? pa_max : digital_max,
 					    true);
 		if (ret)
 			return ret;
 	}
 	for (i = 0; i < ARRAY_SIZE(optional); i++) {
 		ret = x1e80100_limit_volume(card, optional[i],
-					    strstr(optional[i], "PA Volume") ? 6 : 81,
+					    strstr(optional[i], "PA Volume") ? pa_max : digital_max,
 					    false);
 		if (ret)
 			return ret;
 	}
 	sp11_guard_caps_ready(true);
-	dev_info(card->dev, "speaker volume caps ready\n");
+	dev_info(card->dev, "speaker volume caps ready (%s: digital %d, PA %d)\n",
+		 closed_loop ? "closed-loop" : "D26/open-loop", digital_max, pa_max);
 	return 0;
 }
 
@@ -99,6 +123,8 @@ static int x1e80100_card_late_probe(struct snd_soc_card *card)
 	/*
 	 * late_probe runs after all card components have bound and before ALSA
 	 * registers PCM devices, so WSA controls exist before caps are required.
+	 * The q6apm component probe has already parsed the topology and selected
+	 * the guard mode, so the caps can follow the closed-loop or D26 ceiling.
 	 * Keep the card available for microphones/DP if a speaker control is
 	 * absent; caps_ready remains false and the amplifier stays muted.
 	 */
-- 
