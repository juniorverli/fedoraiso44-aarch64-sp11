From: Audio speakers <audio-speakers@localhost>
Subject: [PATCH] ASoC: qcom: remove the D26 open-loop speaker mode

Speaker protection with V/I feedback is now delivered and evidenced on the
device. The D26 open-loop experiment, which allowed playback under volume caps
alone (operator exception of 2026-10-30), no longer makes sense: a volume cap
is not protection, and two paths to unmute the same amplifiers double the
surface to audit. A topology without the SP module is now refused, so the
speakers stay silent while microphones and DisplayPort keep working; the
81/6 caps remain as a second line of defence. The guard's debugfs and logs
report only closed-loop or refused.

Assisted-by: Claude Code
---
--- a/sound/soc/qcom/sp11-guard.c
+++ b/sound/soc/qcom/sp11-guard.c
@@ -57,7 +57,6 @@ MODULE_PARM_DESC(allow_nominal,
 enum sp11_mode {
 	SP11_MODE_UNKNOWN,
 	SP11_MODE_CLOSED_LOOP,
-	SP11_MODE_OPEN_LOOP,
 	SP11_MODE_REFUSED,
 };
 
@@ -96,12 +95,16 @@ int sp11_guard_select_mode(bool marker_valid, bool has_sp)
 	unsigned long flags;
 	enum sp11_mode mode;
 
-	if (!marker_valid)
-		mode = SP11_MODE_REFUSED;
-	else if (has_sp)
+	/*
+	 * Speaker protection with V/I feedback is the only mode: a topology
+	 * without the SP module is refused, so the speakers stay silent (the
+	 * microphone and DisplayPort paths keep working). The D26 open-loop
+	 * experiment is gone; S1 wants protection, not a volume cap.
+	 */
+	if (marker_valid && has_sp)
 		mode = SP11_MODE_CLOSED_LOOP;
 	else
-		mode = SP11_MODE_OPEN_LOOP;
+		mode = SP11_MODE_REFUSED;
 
 	spin_lock_irqsave(&guard.lock, flags);
 	if (guard.mode != SP11_MODE_UNKNOWN && guard.mode != mode) {
@@ -113,7 +116,6 @@ int sp11_guard_select_mode(bool marker_valid, bool has_sp)
 	spin_unlock_irqrestore(&guard.lock, flags);
 
 	pr_info_once("sp11: selected %s speaker mode\n",
-		     mode == SP11_MODE_OPEN_LOOP ? "D26 open-loop" :
 		     mode == SP11_MODE_CLOSED_LOOP ? "closed-loop" : "refused");
 	return mode == SP11_MODE_REFUSED ? -EOPNOTSUPP : 0;
 }
@@ -133,8 +135,8 @@ EXPORT_SYMBOL_GPL(sp11_guard_caps_ready);
  * The parsed topology is the only source of the mode; it is selected in the
  * q6apm component probe, before the card late probe installs the caps. A
  * refused or failed topology parse leaves the mode unknown, which reads as
- * false here, so the D26/open-loop ceiling stays in place. This is a
- * read-only view for the machine driver and does not bypass any gate.
+ * false here, so the lower ceiling stays in place. This is a read-only view
+ * for the machine driver and does not bypass any gate.
  */
 bool sp11_guard_closed_loop(void)
 {
@@ -180,8 +182,6 @@ static const char *sp11_guard_reason(void)
 
 	if (reason)
 		return reason;
-	if (guard.mode == SP11_MODE_OPEN_LOOP)
-		return NULL;
 	if (sp11_guard_degraded_fault())
 		return "degraded diagnostics prerequisites are incomplete";
 	if (!guard.graph_up)
@@ -561,7 +561,6 @@ static int sp11_guard_show(struct seq_file *s, void *unused)
 		   guard.streams[SP11_STREAM_CPS], guard.cps_required);
 	seq_printf(s, "sp_enabled: %d\ndiagnostics_degraded: %d\nmode: %s\ncaps_ready: %d\n",
 		   guard.sp_enabled, guard.diagnostics_degraded,
-		   guard.mode == SP11_MODE_OPEN_LOOP ? "open-loop" :
 		   guard.mode == SP11_MODE_CLOSED_LOOP ? "closed-loop" : "refused",
 		   guard.caps_ready);
 	seq_printf(s, "degraded_fault: %d\n", sp11_guard_degraded_fault());
--- a/sound/soc/qcom/x1e80100.c
+++ b/sound/soc/qcom/x1e80100.c
@@ -52,7 +52,8 @@ static int x1e80100_limit_volume(struct snd_soc_card *card, const char *name,
 /*
  * Speaker volume ceilings.
  *
- * - D26/open-loop (no parsed SP+VI topology) keeps the safe values this
+ * - a topology without the parsed SP+VI chain (D26 profiles, refused modes)
+ *   keeps the safe values this
  *   machine has always used: WSA RX/RX_MIX 81 (-3 dB) and PA 6 (0 dB).
  * - Closed-loop (the topology parse found the SP module and selected the
  *   closed-loop mode) uses the Windows endpoint values recovered from
@@ -62,7 +63,7 @@ static int x1e80100_limit_volume(struct snd_soc_card *card, const char *name,
  *
  * The mode is selected by audioreach_sp11_policy() in the q6apm component
  * probe, which runs before the card late probe that installs these caps. An
- * unknown, refused or open-loop mode therefore keeps the D26 values.
+ * unknown, refused or D26-profile mode therefore keeps the lower values.
  */
 #define SP11_D26_DIGITAL_MAX	81	/* -3 dB */
 #define SP11_D26_PA_MAX		6	/* 0 dB */
@@ -111,7 +112,7 @@ static int x1e80100_install_spk_caps(struct snd_soc_card *card)
 	}
 	sp11_guard_caps_ready(true);
 	dev_info(card->dev, "speaker volume caps ready (%s: digital %d, PA %d)\n",
-		 closed_loop ? "closed-loop" : "D26/open-loop", digital_max, pa_max);
+		 closed_loop ? "closed-loop" : "fallback (no closed loop)", digital_max, pa_max);
 	return 0;
 }
 
