From: SP11 audio worker <audio-worker@localhost>
Subject: [PATCH candidate] ASoC: qcom: validate SP11 flags and report VI identity

The SP11CA01 envelope defines only a nominal flag and zero reserved fields.
Reject unknown bits and reserved data instead of interpreting unknown
flags as measured calibration. Reject unknown SP11CL01 flags too.
Report whether calibration and running VI graph identities match and
whether multiple VI identities are ambiguous. This is read-only guard
instrumentation; it does not establish valid sense samples or protection.

Apply after the kernel worker's calibration-lifetime candidate. No policy
is relaxed and no hardware setting or calibration value is changed.

---
diff --git a/sound/soc/qcom/qdsp6/audioreach-sp11.c b/sound/soc/qcom/qdsp6/audioreach-sp11.c
--- a/sound/soc/qcom/qdsp6/audioreach-sp11.c
+++ b/sound/soc/qcom/qdsp6/audioreach-sp11.c
@@ -173,6 +173,10 @@
 	cl->n_links = le32_to_cpu(hdr->n_links);
 	cl->n_cal = le32_to_cpu(hdr->n_cal);
 	cl->flags = le32_to_cpu(hdr->flags);
+	if (cl->flags & ~SP11CL_FLAG_CPS) {
+		dev_err(dev, "sp11cl: unknown flags\n");
+		return false;
+	}
 	for (i = 0; i < SP11_CAL_CH; i++)
 		cl->nominal_re_q24[i] = le32_to_cpu(hdr->nominal_re_q24[i]);
 
@@ -375,11 +379,23 @@
 		goto out;
 	}
 
+	if (le32_to_cpu(hdr->flags) & ~SP11CAL_FLAG_NOMINAL) {
+		dev_err(graph->dev, "%s: unknown calibration flags\n", cl->cal_name);
+		ret = -EINVAL;
+		goto out;
+	}
+
 	for (i = 0; i < SP11_CAL_CH; i++) {
 		u64 r0 = le32_to_cpu(hdr->ch[i].r0_q24);
 		s16 t0 = (s16)le16_to_cpu(hdr->ch[i].t0_q6);
 		u64 nom = cl->nominal_re_q24[i];
 
+		if (hdr->ch[i].reserved) {
+			dev_err(graph->dev, "speaker %u calibration reserved field is nonzero\n",
+				i);
+			ret = -EINVAL;
+			goto out;
+		}
 		if (!nom || r0 * 100 < nom * SP11_R0_MIN_PERCENT ||
 		    r0 * 100 > nom * SP11_R0_MAX_PERCENT ||
 		    t0 < SP11_T0_MIN_Q6 || t0 > SP11_T0_MAX_Q6) {
diff --git a/sound/soc/qcom/sp11-guard.c b/sound/soc/qcom/sp11-guard.c
--- a/sound/soc/qcom/sp11-guard.c
+++ b/sound/soc/qcom/sp11-guard.c
@@ -487,6 +487,8 @@
 		   guard.caps_ready);
 	seq_printf(s, "degraded_fault: %d\n", sp11_guard_degraded_fault());
 	seq_printf(s, "cal_mask: 0x%x\ncal_nominal: %d\n", guard.cal_mask, guard.cal_nominal);
+	seq_printf(s, "cal_graph_matches_vi: %d\nvi_ambiguous: %d\n",
+		   sp11_guard_cal_matches_vi(), guard.vi_ambiguous);
 	seq_printf(s, "fault: %d (%s, 0x%08x)\nnospk: %d\nallow_nominal: %d\n",
 		   guard.fault, guard.fault ? guard.fault_src : "-", guard.fault_code,
 		   nospk, allow_nominal);
