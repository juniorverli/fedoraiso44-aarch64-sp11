// SPDX-License-Identifier: BSD-3-Clause
/*
 * M15 combined diagnostic default: everything under test in one boot. The M15 fallback content (m15-safe)
 * (microphones, DisplayPort audio, touch on) plus the Adreno GPU (as m13-gpu: &gpu with GMU and zap) and the rear
 * OV13858, front IMX681 and IR camera chains enabled (as hardware/cameras/dtb-variants cam-all).
 * Speakers stay off (S1, D26): only m15-spk may enable them. The fallback is m15-safe.
 * The IR emitter and flash stay undescribed (S2).
 * Built by the kernel DTB variants script; not a patch, not part of the RPM.
 */
#include "x1p64100-microsoft-denali-m15-safe.dts"

/*
 * USB-C experiment (usb-typec patch 0003, hardware/usb-typec/evidence/2026-10-31-double-flip-verdict.md): only this
 * variant runs without the QMP PHY orientation switches, as the packaged board DT does. m15-safe (and every other
 * M15 variant) re-adds them, so the fallbacks keep the old behaviour.
 */
&usb_1_ss0_qmpphy {
	/delete-property/ orientation-switch;
};

&usb_1_ss1_qmpphy {
	/delete-property/ orientation-switch;
};

&gpu {
	status = "okay";
};

&apps_rsc {
	regulators-8 {
		status = "okay";
	};
};

&vreg_l7b_2p8 {
	status = "okay";
};

&{/camera-leds} {
	status = "okay";
};

&camss {
	status = "okay";
};

&cci0 {
	status = "okay";
};

&cci0_i2c0 {
	status = "okay";
};

&cci0_i2c1 {
	status = "okay";
};

&cci1 {
	status = "okay";
};

&cci1_i2c1 {
	status = "okay";
};
