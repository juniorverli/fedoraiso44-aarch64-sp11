# Surface Pro 11 (X1P64100 LCD) Kconfig fragment, merged on top of the
# Fedora 44 aarch64 config with scripts/kconfig/merge_config.sh.
# Owner: kernel worker. Every symbol was checked to exist in v7.3.

# --- D2: BTF is always on --------------------------------------------------
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y

# --- phase 1: display ------------------------------------------------------
CONFIG_DRM_MSM=m
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DP=y
CONFIG_DRM_DISPLAY_DP_AUX_BUS=m
CONFIG_DRM_PANEL_EDP=m
CONFIG_PHY_QCOM_EDP=m
CONFIG_CLK_X1E80100_DISPCC=m
CONFIG_BACKLIGHT_PWM=m
CONFIG_LEDS_QCOM_LPG=m
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y

# --- phase 1: GPU ----------------------------------------------------------
CONFIG_CLK_X1E80100_GPUCC=m
CONFIG_DRM_MSM_GPU_STATE=y

# --- phase 1: boot essentials ----------------------------------------------
CONFIG_ARM_SCMI_CPUFREQ=m
CONFIG_QCOM_GENI_SE=y
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_PMIC_GLINK=m
CONFIG_BATTERY_QCOM_BATTMGR=m
CONFIG_TYPEC_MUX_PS883X=m
CONFIG_SURFACE_AGGREGATOR=m
CONFIG_SURFACE_AGGREGATOR_BUS=y
CONFIG_SURFACE_AGGREGATOR_REGISTRY=m

# --- D10: Hyper-V guest, so the same kernel boots in the L2 test VM -------
CONFIG_HYPERV=y
CONFIG_HYPERV_VMBUS=m
CONFIG_HYPERV_STORAGE=m
CONFIG_HYPERV_NET=m
CONFIG_DRM_HYPERV=m
CONFIG_HYPERV_KEYBOARD=m
CONFIG_HID_HYPERV_MOUSE=m
