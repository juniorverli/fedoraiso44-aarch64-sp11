# Surface Pro 11 (X1P64100 LCD) Kconfig fragment, merged on top of the
# Fedora 44 aarch64 config with scripts/kconfig/merge_config.sh.
# Owner: kernel worker. Every symbol was checked to exist in v7.3.

# --- D2: BTF is always on --------------------------------------------------
CONFIG_DEBUG_INFO=y
# Fedora selects DWARF_TOOLCHAIN_DEFAULT in the same Kconfig choice; it must go for DWARF5=y to hold.
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
# Compressed DWARF: measured -33% O= size on a defconfig build, BTF byte-identical (kernel/README.md).
# CONFIG_DEBUG_INFO_COMPRESSED_NONE is not set
CONFIG_DEBUG_INFO_COMPRESSED_ZSTD=y

# --- phase 1: display ------------------------------------------------------
CONFIG_DRM_MSM=m
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DP=y
CONFIG_DRM_DISPLAY_DP_AUX_BUS=m
CONFIG_DRM_PANEL_EDP=m
# M3 (D19): /dev/drm_dp_aux* for eDP AUX diagnostics. The brief said DRM_DP_AUX_CHARDEV; 7.3 names it DRM_DISPLAY_DP_AUX_CHARDEV.
CONFIG_DRM_DISPLAY_DP_AUX_CHARDEV=y
CONFIG_PHY_QCOM_EDP=m
CONFIG_CLK_X1E80100_DISPCC=m
CONFIG_BACKLIGHT_PWM=m
CONFIG_LEDS_QCOM_LPG=m
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y

# --- phase 1: GPU ----------------------------------------------------------
CONFIG_CLK_X1E80100_GPUCC=m
CONFIG_DRM_MSM_GPU_STATE=y

# --- phase 1: boot essentials ----------------------------------------------
CONFIG_ARM_SCMI_CPUFREQ=m
CONFIG_QCOM_GENI_SE=y
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_PMIC_GLINK=m
CONFIG_BATTERY_QCOM_BATTMGR=m
CONFIG_TYPEC_MUX_PS883X=m
CONFIG_SURFACE_AGGREGATOR=m
CONFIG_SURFACE_AGGREGATOR_BUS=y
CONFIG_SURFACE_AGGREGATOR_REGISTRY=m

# --- M7: ath12k diagnostics (Wi-Fi K2) -------------------------------------
CONFIG_ATH12K_DEBUG=y

# --- M8: spi-hid v7 and the preloaded QSPI/GPI touch path -------------------
CONFIG_SPI_MEM=y
CONFIG_SPI_HID=m
CONFIG_SPI_HID_OF=m
CONFIG_SPI_HID_ACPI=m
CONFIG_SPI_QCOM_GENI=m
CONFIG_QCOM_GPI_DMA=m
CONFIG_REGULATOR_FIXED_VOLTAGE=m
CONFIG_HID_MULTITOUCH=m
CONFIG_HIDRAW=y
CONFIG_INPUT_UINPUT=m

# --- D10: Hyper-V guest, so the same kernel boots in the L2 test VM -------
CONFIG_HYPERV=y
CONFIG_HYPERV_VMBUS=m
CONFIG_HYPERV_STORAGE=m
CONFIG_HYPERV_NET=m
CONFIG_DRM_HYPERV=m
CONFIG_HYPERV_KEYBOARD=m
CONFIG_HID_HYPERV_MOUSE=m

# --- firmware worker request (fb98754): in-kernel pd-mapper, xz firmware ----
# Fedora 44 has no userspace pd-mapper (qrtr obsoletes it); qcom_pd_mapper.c serves x1e80100.
# GPU firmware gen70500_* ships as .xz in Fedora's qcom-firmware.
CONFIG_QCOM_PD_MAPPER=m
CONFIG_QRTR=m
CONFIG_FW_LOADER_COMPRESS_XZ=y
# CONFIG_FW_LOADER_USER_HELPER is not set

# --- image worker request: QEMU L1 test and live ISO ------------------------
# Fedora's aarch64 config already has these values; pinned here so the check covers them.
CONFIG_SQUASHFS=m
CONFIG_SQUASHFS_ZSTD=y
CONFIG_VFAT_FS=m
CONFIG_ISO9660_FS=m
CONFIG_OVERLAY_FS=m
CONFIG_BLK_DEV_LOOP=m
CONFIG_EFI_STUB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_XHCI_PLATFORM=m
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=m
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=m
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_INPUT=m
CONFIG_SCSI_VIRTIO=m
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_HW_RANDOM_VIRTIO=y

# --- M13: boot-argument tooling (dyndbg=, trace_event=) ---------------------
# The M12 device logs showed `*.dyndbg=` and `trace_event=` boot arguments having no effect, so the
# options are pinned here and asserted again in scripts/kernel-check (the Fedora config sets them today).
CONFIG_DYNAMIC_DEBUG=y
CONFIG_DYNAMIC_DEBUG_CORE=y
CONFIG_FTRACE=y
CONFIG_TRACING=y
CONFIG_EVENT_TRACING=y

# --- M13: rear camera (cameras R1: OV13858 + CAMSS + CCI), DT-disabled by default ---
CONFIG_VIDEO_OV13858=m
CONFIG_VIDEO_QCOM_CAMSS=m
CONFIG_I2C_QCOM_CCI=m
CONFIG_LEDS_GPIO=m
CONFIG_CLK_X1E80100_CAMCC=m
CONFIG_REGULATOR_QCOM_RPMH=y

# --- M13: audio (GPR callback fix 0006/0007, WSA gate 0009) ---
CONFIG_SND_SOC_QDSP6_APM=m
CONFIG_QCOM_APR=m
CONFIG_SND_SOC_WSA884X=m
CONFIG_SND_SOC_X1E80100=m
CONFIG_SURFACE_AGGREGATOR=m
