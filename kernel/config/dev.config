# Dev profile only (scripts/kernel-dev.sh): fixes upstream arm64 defconfig so that sp11.config holds.
# Merged after sp11.config; the dev config check uses sp11.config with these symbols replaced.
# Never used by the release (RPM) build, which starts from the Fedora config.

# defconfig sets DEBUG_INFO_REDUCED=y, which makes DEBUG_INFO_BTF unselectable (D2).
# CONFIG_DEBUG_INFO_REDUCED is not set
# FW_LOADER_COMPRESS_XZ depends on this.
CONFIG_FW_LOADER_COMPRESS=y
# defconfig has a built-in user of the xHCI platform glue, so =m cannot hold.
CONFIG_USB_XHCI_PLATFORM=y
