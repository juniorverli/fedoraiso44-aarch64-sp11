# Fedora 44 aarch64 build and test container of the image worker.
# Built and run by scripts/image-container.sh. Nothing is installed on the host.
# D16: kiwi (kiwi-cli 11.1.x in Fedora 44) builds the ISO; lorax stays until the kiwi ISO passes L0 and L1.
# Fedora-native (D12): official fedora:44 base, all tools from Fedora packages.
FROM registry.fedoraproject.org/fedora:44

RUN dnf -y --setopt=install_weak_deps=False install \
        lorax lorax-lmc-novirt lorax-templates-generic \
        anaconda anaconda-live pykickstart \
        dracut dracut-live \
        grub2-efi-aa64 grub2-efi-aa64-cdboot grub2-efi-aa64-modules grub2-tools grub2-tools-extra \
        shim-aa64 \
        xorriso mtools dosfstools isomd5sum gdisk util-linux parted \
        squashfs-tools erofs-utils createrepo_c cpio kmod rpm-build \
        dtc edid-decode v4l-utils \
        qemu-system-aarch64-core qemu-img edk2-aarch64 \
        qemu-device-display-virtio-gpu qemu-device-display-virtio-gpu-pci qemu-device-usb-host \
        kiwi-cli kiwi-systemdeps-core kiwi-systemdeps-bootloaders kiwi-systemdeps-filesystems \
        kiwi-systemdeps-iso-media distribution-gpg-keys dnf5 \
        python3 python3-pexpect jq git curl tar xz zstd file findutils procps-ng \
 && dnf clean all

WORKDIR /sp11
