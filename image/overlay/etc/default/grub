# SP11: kernel command line of the installed system (decision D9). Verbose, no splash.
GRUB_TIMEOUT=10
GRUB_TIMEOUT_STYLE=menu
GRUB_DISTRIBUTOR="$(sed 's, release .*$,,g' /etc/system-release)"
# The installed system boots the closed-loop audio entry generated by
# /etc/grub.d/45_sp11_closed_loop; the D26 BLS entries remain as fallback.
GRUB_DEFAULT=sp11-closed-loop-audio
GRUB_DISABLE_SUBMENU=true
GRUB_TERMINAL_OUTPUT="console"
GRUB_CMDLINE_LINUX="debug loglevel=8 ignore_loglevel printk.devkmsg=on log_buf_len=16M rd.plymouth=0 plymouth.enable=0 systemd.show_status=1 rd.udev.log_level=info console=tty0 msm.skip_gpu=1"
GRUB_DISABLE_RECOVERY="true"
GRUB_ENABLE_BLSCFG=true
