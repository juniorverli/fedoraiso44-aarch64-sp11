# SP11 log collector: enable it by preset. A kiwi image ships /etc/machine-id as "uninitialized",
# so systemd runs `preset-all` on first boot; without this line the preset policy of Fedora
# (90-default.preset, `disable *`) removed the multi-user.target.wants symlink at 379 s of the
# first L1 run ("Removed '/etc/systemd/system/multi-user.target.wants/sp11-log-collector.service'")
# and the collector never ran.
enable sp11-log-collector.service
enable sp11-log-collector-session-first.path
enable sp11-log-collector-session-user.path
enable sp11-rfkill-events.service
enable sp11-bt-address.service
enable sp11-ssam-shutdown.service
enable sp11-ssam-rebind.service
# M15: the GPU two-step is enabled; it runs only when sp11.gpu_diag=1 is manually supplied.
enable sp11-gpu-two-step.service
enable sp11-sam-mode-rotor.service
enable sp11-cdsp-experiment.service
enable sp11-cpufreq-cap.service
enable sp11-identity-switch.service
enable sp11-wifi-identity.service
enable sp11-identity-bt-pre.service
enable sp11-suspend-policy.service
enable sp11-wakeup-policy.service
enable sp11-suspend-diag.service
enable sp11-thermal-sample.service
enable sp11-spectra-load.service
enable sp11-kmsg-tail.service
enable sp11-gpu-no-runtime-pm.service
# These are enabled by a build-time symlink; preset-all on first boot would remove it
# (Fedora 90-default.preset is `disable *`). Keep them enabled by preset as well.
enable sp11-cl-validate.service
enable sp11-closed-loop-sense.service
enable sp11-closed-loop-selftest.service
enable sp11-first-boot.service
