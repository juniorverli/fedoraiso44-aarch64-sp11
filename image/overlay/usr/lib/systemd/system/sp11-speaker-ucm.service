[Unit]
Description=SP11 D26 speaker UCM overlay (runs on debug, safe and spk entries)
ConditionKernelCommandLine=|sp11.entry=spk
ConditionKernelCommandLine=|sp11.entry=debug
ConditionKernelCommandLine=|sp11.entry=safe
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target sound.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/sp11/speaker-ucm-enable

[Install]
WantedBy=sysinit.target
