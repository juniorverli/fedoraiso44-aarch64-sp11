[Unit]
Description=SP11 log collector: the first numbered user session (the autologin session of liveuser) exists
DefaultDependencies=no
After=local-fs.target
Conflicts=shutdown.target
Before=shutdown.target

[Path]
PathExistsGlob=/run/systemd/sessions/[0-9]*
Unit=sp11-log-collector-session@user.service

[Install]
WantedBy=multi-user.target
