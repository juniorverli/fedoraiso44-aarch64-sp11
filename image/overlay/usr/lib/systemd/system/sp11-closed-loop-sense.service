[Unit]
Description=SP11 closed-loop V/I sense trigger (closed-loop boot entries only)
Documentation=file:/usr/share/doc/sp11/closed-loop.md
# Both closed-loop entries carry sp11.allow_nominal=1 (line 24, the closed-loop
# audio entry, and line 5, the speaker first-test entry); the public D26 entries
# do not. The kill switch always wins.
ConditionKernelCommandLine=sp11.allow_nominal=1
ConditionKernelCommandLine=!sp11.nospk
# PipeWire/ACP builds the card profile when the session starts and probes the
# card's PCMs; holding MultiMedia5 before that makes ACP drop the whole card
# (device log 2026-11-06: only the virtual echo-cancel nodes appeared on this
# entry, while the D26 entry had Speaker and Mic). Let the profile exist first.
After=local-fs.target sound.target graphical.target

[Service]
Type=simple
ExecStartPre=/usr/bin/sleep 20
ExecStart=/usr/libexec/sp11/closed-loop-sense
Restart=always
RestartSec=3
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
