[Unit]
Description=SP11 closed-loop V/I sense trigger (closed-loop boot entries only)
Documentation=file:/usr/share/doc/sp11/closed-loop.md
# Both closed-loop entries carry sp11.allow_nominal=1 (line 24, the closed-loop
# audio entry, and line 5, the speaker first-test entry); the public D26 entries
# do not. The kill switch always wins.
ConditionKernelCommandLine=sp11.allow_nominal=1
ConditionKernelCommandLine=!sp11.nospk
After=local-fs.target sound.target
Before=graphical.target

[Service]
Type=simple
ExecStart=/usr/libexec/sp11/closed-loop-sense
Restart=always
RestartSec=3
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
