[Unit]
Description=SP11: pin the platform sound speaker and microphone as PipeWire defaults
After=wireplumber.service pipewire.service
ConditionUser=!gdm
PartOf=graphical-session.target
Wants=wireplumber.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/sp11/audio-defaults
RemainAfterExit=yes
TimeoutStartSec=90

[Install]
WantedBy=graphical-session.target
