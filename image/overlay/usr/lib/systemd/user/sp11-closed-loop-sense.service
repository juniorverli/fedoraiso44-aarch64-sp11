[Unit]
Description=SP11 closed-loop V/I sense trigger (closed-loop boot entries)
ConditionKernelCommandLine=sp11.allow_nominal=1
ConditionKernelCommandLine=!sp11.nospk
# sp11-audio-defaults returns only after PipeWire created the platform Speaker
# and Mic nodes; starting after it guarantees the card profile exists before
# MultiMedia5 is taken, or ACP drops the whole card.
After=wireplumber.service pipewire.service sp11-audio-defaults.service
Wants=sp11-audio-defaults.service
ConditionUser=!gdm
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/libexec/sp11/closed-loop-sense
Restart=always
RestartSec=3
TimeoutStopSec=5

[Install]
WantedBy=graphical-session.target
