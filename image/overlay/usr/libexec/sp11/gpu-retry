#!/usr/bin/bash
# Clear the GPU marker (sp11_gpu_state) on the boot medium: a plain file written by sp11-boot-state; GRUB is static and never reads it.
# The two-step runs on every boot of line 1; the owner's loop guard (a step that killed the previous boot is skipped) uses its own markers.
set -eu
/usr/libexec/sp11-boot-state unset sp11_gpu_state
echo "sp11_gpu_state cleared."
