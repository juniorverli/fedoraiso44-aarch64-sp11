#!/usr/bin/python3
"""Pin the platform sound card's Speaker sink and Mic source as PipeWire defaults.

Runs as the logged-in user from sp11-audio-defaults.service after WirePlumber.
The closed-loop entries keep a root holder on the MultiMedia5 trigger (the V/I
sense back end); that PCM is not a microphone, so it must never become the
default source. The script selects, by name, the sink and source that belong to
the platform sound card and leaves every other node alone. It changes no
volume, mute or route, and writes one line per decision to the journal.
"""

import json
import subprocess
import sys
import time

PLATFORM = "platform-sound"


def wpctl(*args):
    try:
        return subprocess.run(["wpctl", *args], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None


def nodes():
    try:
        out = subprocess.run(["pw-dump"], capture_output=True, text=True, timeout=15).stdout
        return json.loads(out)
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return []


def props(o):
    return (o.get("info") or {}).get("props") or {}


def pick(objects, media_class, want_mic):
    best = None
    for o in objects:
        p = props(o)
        if p.get("media.class") != media_class:
            continue
        if o.get("id") is None:
            continue
        names = " ".join(str(p.get(k, "")) for k in ("node.name", "device.name", "node.description",
                                                      "node.nick", "alsa.card_name", "device.description"))
        if PLATFORM not in names:
            continue
        if "MultiMedia5" in names:
            print(f"sp11-audio-defaults: skip {media_class} {o['id']} ({p.get('node.name')}): "
                  "the V/I trigger is not a microphone", flush=True)
            continue
        score = 0
        if want_mic and any(k in names.lower() for k in ("mic", "microphone")):
            score += 2
        if not want_mic and any(k in names.lower() for k in ("speaker", "analog", "hifi")):
            score += 2
        if best is None or score > best[0]:
            best = (score, o["id"], p.get("node.name", ""))
    return best


def main():
    deadline = time.monotonic() + 30
    objects = []
    while time.monotonic() < deadline:
        objects = nodes()
        if any(props(o).get("media.class") in ("Audio/Sink", "Audio/Source") and
               PLATFORM in " ".join(str(props(o).get(k, "")) for k in ("node.name", "device.name"))
               for o in objects):
            break
        time.sleep(0.5)
    if not objects:
        print("sp11-audio-defaults: pw-dump gave nothing; leaving the defaults alone", file=sys.stderr, flush=True)
        return 0

    done = 0
    for media, want_mic in (("Audio/Sink", False), ("Audio/Source", True)):
        best = pick(objects, media, want_mic)
        if not best:
            print(f"sp11-audio-defaults: no {media} of {PLATFORM}; leaving the default alone", flush=True)
            continue
        _, node_id, name = best
        r = wpctl("set-default", str(node_id))
        if r is None or r.returncode != 0:
            print(f"sp11-audio-defaults: wpctl set-default {node_id} failed", file=sys.stderr, flush=True)
            continue
        print(f"sp11-audio-defaults: default {media} is {node_id} ({name})", flush=True)
        done += 1
    return 0 if done else 1


if __name__ == "__main__":
    sys.exit(main())
