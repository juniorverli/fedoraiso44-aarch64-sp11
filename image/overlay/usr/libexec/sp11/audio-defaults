#!/usr/bin/python3
"""Pin the platform sound card's Speaker sink and Mic source as PipeWire defaults.

Runs as the logged-in user from sp11-audio-defaults.service after WirePlumber.
The closed-loop entries keep a root holder on the MultiMedia5 trigger (the V/I
sense back end); that PCM is not a microphone, so it must never become the
default source.

Selection: prefer a node whose properties mention the platform sound card
(platform-sound, x1e80100, surface); if no name matches but exactly one sink or
source exists, use it. Every sink/source name is written to the journal so the
next boot shows what PipeWire actually created. No volume, mute or route is
written.
"""

import json
import subprocess
import sys
import time

HINTS = ("platform-sound", "x1e80100", "surface")
TRIGGER = "multimedia5"


def nodes():
    try:
        out = subprocess.run(["pw-dump"], capture_output=True, text=True, timeout=15).stdout
        return json.loads(out)
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return []


def props(o):
    return (o.get("info") or {}).get("props") or {}


def names_of(p):
    return " ".join(str(p.get(k, "")) for k in (
        "node.name", "node.description", "node.nick", "device.name",
        "device.description", "alsa.card_name", "alsa.card"))


def candidates(objects, media_class):
    """Only nodes backed by an ALSA device; virtual echo-cancel/dsp nodes are not hardware."""
    out = []
    for o in objects:
        p = props(o)
        if p.get("media.class") != media_class or o.get("id") is None:
            continue
        if not (str(p.get("api.alsa.pcm.card", "")).isdigit() or
                "alsa_card" in str(p.get("device.name", "")) or
                str(p.get("device.api", "")) == "alsa"):
            continue
        out.append((o["id"], names_of(p), p))
    return out


def pick(items, want_mic):
    trigger = [i for i in items if TRIGGER in i[1].lower()]
    usable = [i for i in items if TRIGGER not in i[1].lower()]
    for i in trigger:
        print(f"sp11-audio-defaults: skip {i[0]} ({i[1].strip()}): the V/I trigger is not a microphone",
              flush=True)
    if not usable:
        return None
    hinted = [i for i in usable if any(h in i[1].lower() for h in HINTS)]
    pool = hinted or (usable if len(usable) == 1 else [])
    if not pool:
        print("sp11-audio-defaults: several candidates and none names the platform card: "
              + "; ".join(f"{i[0]}={i[1].strip()}" for i in usable), flush=True)
        return None
    keyword = ("mic", "microphone") if want_mic else ("speaker", "hifi", "analog")
    scored = sorted(pool, key=lambda i: (sum(k in i[1].lower() for k in keyword), -i[0]), reverse=True)
    return scored[0]


def main():
    deadline = time.monotonic() + 60
    objects = []
    while time.monotonic() < deadline:
        objects = nodes()
        if candidates(objects, "Audio/Sink") or candidates(objects, "Audio/Source"):
            break
        time.sleep(1)
    if not objects:
        print("sp11-audio-defaults: pw-dump gave nothing; leaving the defaults alone",
              file=sys.stderr, flush=True)
        return 0

    done = 0
    for media, want_mic in (("Audio/Sink", False), ("Audio/Source", True)):
        items = candidates(objects, media)
        best = pick(items, want_mic)
        if not best:
            print(f"sp11-audio-defaults: no usable {media}; leaving the default alone", flush=True)
            continue
        node_id, name, _ = best
        r = subprocess.run(["wpctl", "set-default", str(node_id)], capture_output=True, text=True)
        if r.returncode != 0:
            print(f"sp11-audio-defaults: wpctl set-default {node_id} failed: {r.stderr.strip()}",
                  file=sys.stderr, flush=True)
            continue
        print(f"sp11-audio-defaults: default {media} is {node_id} ({name.strip()})", flush=True)
        done += 1
    return 0 if done else 1


if __name__ == "__main__":
    sys.exit(main())
