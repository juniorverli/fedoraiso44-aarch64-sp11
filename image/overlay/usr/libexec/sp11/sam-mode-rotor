#!/usr/bin/bash
# SAM shutdown mode rotor (M14). Every boot takes the next mode of /usr/share/sp11/sam-mode-order (silent, clean, quiet, default, repeat),
# writes it to /sys/module/surface_aggregator/parameters/shutdown_mode, records it and shows it to the operator. The counter lives in the
# GRUB environment block of the boot medium (sp11-esp-env, S4: never the internal disk). The mode acts at the next poweroff, so the
# operator tests it with `systemctl poweroff` and then boots Windows (ec-sam evidence 2026-10-30-windows-transition.md section 6).
# An explicit surface_aggregator.shutdown_mode= on the kernel line wins: it is recorded, nothing is changed, the counter does not advance.
set -u
export LC_ALL=C PATH=/usr/sbin:/usr/bin:/sbin:/bin
P=${SP11_SAM_PARAM:-/sys/module/surface_aggregator/parameters/shutdown_mode}
ORDER=${SP11_SAM_ORDER:-/usr/share/sp11/sam-mode-order}
STATE=${SP11_SAM_STATE:-/run/sp11/sam-mode}
CMDLINE=${SP11_SAM_CMDLINE:-/proc/cmdline}
ESP=${SP11_ESP_ENV:-/usr/libexec/sp11-esp-env}
NOTICE=${SP11_NOTICE:-/usr/libexec/sp11/operator-notice}
mkdir -p "$(dirname "$STATE")"
modes=($(grep -v '^[[:space:]]*#' "$ORDER" | tr -s ' \t\n' ' '))
[ "${#modes[@]}" -gt 0 ] || modes=(default)
note() { echo "sp11-sam-mode-rotor: $*" >&2; }
arg=$(tr ' ' '\n' <"$CMDLINE" | sed -n 's/^surface_aggregator\.shutdown_mode=//p' | tail -n1)
source=rotor
if [ -n "$arg" ]; then
	mode=$arg source="kernel command line (rotor not advanced)"
else
	c=$("$ESP" get sp11_sam_counter 2>/dev/null)
	case $c in '' | *[!0-9]*) c=0 ;; esac
	mode=${modes[$((c % ${#modes[@]}))]}
	"$ESP" set "sp11_sam_counter=$((c + 1))" 2>/dev/null || source="rotor (counter NOT saved: the boot medium environment block is not writable; the next boot repeats this mode)"
	if [ ! -w "$P" ]; then source="$source; parameter not writable"; fi
	[ -w "$P" ] && printf '%s' "$mode" >"$P" 2>/dev/null
fi
got=$(cat "$P" 2>/dev/null || echo unreadable)
line="SAM shutdown mode for this boot: $mode"
[ "$got" = "$mode" ] || line="$line (module parameter reads: $got)"
{ echo "$line"; echo "source: $source"; echo "order: ${modes[*]}"; } >"$STATE"
note "$line [$source]"
"$NOTICE" add 10-sam "$line. Test it with 'systemctl poweroff' (not reboot), then boot Windows and check the Type Cover keyboard (ec-sam evidence 2026-10-30-windows-transition.md section 6)." || true
exit 0
