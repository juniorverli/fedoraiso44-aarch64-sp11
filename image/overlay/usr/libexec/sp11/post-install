#!/bin/bash
# Post-install configuration inside the installed system (kickstart %post or a
# manual run as root). It never touches the Windows partitions.
#
#   * keeps the Windows entry visible in the Fedora GRUB menu (os-prober);
#   * appends msm.skip_gpu=1 to the installed kernel command line: this machine
#     hard-resets at the first GPU use, and the display works without the
#     Adreno driver (device-confirmed);
#   * removes the identity overrides copied from a private live image
#     (/etc/sp11/bt-address, the Wi-Fi MAC conf and .link), so the installed
#     system uses the machine's own addresses;
#   * regenerates the boot configuration, best effort.
#
# Vendor firmware and tuning are NOT installed here: they are generated on the
# user's own machine from their Windows data (scripts/sp11-local-stage.sh) and
# never redistributed.

set -uo pipefail
log=/var/log/sp11-post-install.log

say() { echo "sp11-post-install: $*" | tee -a "$log"; }

if [ "${1:-}" != "--installed" ]; then
	echo "sp11-post-install: run with --installed from the installer %post" >&2
	exit 2
fi

# grub2-mkconfig sources only /etc/default/grub (not /etc/default/grub.d), so the two
# settings go into that file; grubby also rewrites the BLS entries directly.
set_kv() {
	key=$1 value=$2
	if grep -q "^$key=" /etc/default/grub 2>/dev/null; then
		case $key in
		GRUB_CMDLINE_LINUX) sed -i "s|^$key=.*|$key=\"$value\"|" /etc/default/grub ;;
		*) sed -i "s|^$key=.*|$key=$value|" /etc/default/grub ;;
		esac
	else
		case $key in
		GRUB_CMDLINE_LINUX) printf '%s="%s"\n' "$key" "$value" >>/etc/default/grub ;;
		*) printf '%s=%s\n' "$key" "$value" >>/etc/default/grub ;;
		esac
	fi
}
set_kv GRUB_DISABLE_OS_PROBER false
say "os-prober enabled so the Windows entry stays visible"

cmdline=$(sed -n 's/^GRUB_CMDLINE_LINUX="\(.*\)"$/\1/p' /etc/default/grub | head -n1)
case " $cmdline " in
*" msm.skip_gpu=1 "*) ;;
*) set_kv GRUB_CMDLINE_LINUX "$cmdline msm.skip_gpu=1" ;;
esac
if command -v grubby >/dev/null 2>&1; then
	if grubby --update-kernel=ALL --args="msm.skip_gpu=1" >/dev/null 2>&1; then
		say "msm.skip_gpu=1 written to /etc/default/grub and the BLS entries"
	else
		say "msm.skip_gpu=1 written to /etc/default/grub; grubby failed"
	fi
else
	say "msm.skip_gpu=1 written to /etc/default/grub; grubby missing"
fi

removed=0
for f in /etc/sp11/bt-address /etc/NetworkManager/conf.d/90-sp11-wifi-mac.conf \
	 /etc/systemd/network/10-sp11-wifi.link; do
	if [ -e "$f" ]; then
		rm -f "$f"
		say "removed the private identity override $f"
		removed=$((removed + 1))
	fi
done
[ "$removed" = 0 ] && say "no private identity override present"

# Closed-loop audio entry: only when this (private) image carried the CL topology
# and the m15-cl DTB. The generator is a grub.d script, so it follows kernel
# upgrades; it is never the default entry.
if [ -r /usr/lib/firmware/qcom/x1e80100/X1E80100-Microsoft-Surface-Pro-11-CL-tplg.bin ] &&
	[ -r /boot/dtb/qcom/x1p64100-microsoft-denali-m15-cl.dtb ] &&
	[ -x /usr/libexec/sp11/grub-closed-loop ]; then
	install -m 0755 /usr/libexec/sp11/grub-closed-loop /etc/grub.d/45_sp11_closed_loop
	# The installed system boots the same configuration we delivered on the live
	# media: the closed-loop entry (m15-cl DTB, allow_nominal, the raised ceiling)
	# is the default; the normal Fedora D26 entries stay available as fallback.
	set_kv GRUB_DEFAULT sp11-closed-loop-audio
	say "closed-loop audio entry installed (m15-cl DTB, sp11.allow_nominal=1) and set as the GRUB default"
else
	rm -f /etc/grub.d/45_sp11_closed_loop
fi

if command -v grub2-mkconfig >/dev/null 2>&1; then
	if grub2-mkconfig -o /boot/grub2/grub.cfg >>"$log" 2>&1; then
		say "boot configuration regenerated"
	else
		say "grub2-mkconfig failed; the installed configuration is unchanged"
		say "done $(date -u +%Y-%m-%dT%H:%M:%SZ)"
		exit 1
	fi
else
	say "grub2-mkconfig missing; the installed configuration is unchanged"
fi
say "done $(date -u +%Y-%m-%dT%H:%M:%SZ)"
exit 0
