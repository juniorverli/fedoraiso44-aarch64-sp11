#!/usr/bin/python3
"""Drain /dev/kmsg continuously while a separate thread publishes bounded batches."""
import collections
import os
import re
import select
import subprocess
import sys
import threading
import time

LIMIT = 2 * 1024 * 1024
BATCH_SIZE = 256 * 1024
INTERVAL = 10
pending = collections.deque()
lock = threading.Condition()
size = 0
urgent = False

def is_urgent(data):
    # /dev/kmsg records begin with syslog priority,sequence,timestamp,flags;
    # priorities include a facility, so use their low three bits.
    header, _, message = data.partition(b';')
    try:
        severity = int(header.split(b',', 1)[0]) & 7
    except ValueError:
        severity = 7
    return severity <= 3 or bool(re.search(
        rb'adreno|msm|gmu|gpu|arm-smmu|qcom_scm|power/control|runtime|panic', message, re.I))

def add(data, retry=False):
    global size, urgent
    with lock:
        if not retry and is_urgent(data):
            urgent = True
        if retry:
            pending.appendleft(data[-LIMIT:])
            size += len(pending[0])
        else:
            pending.append(data[-LIMIT:])
            size += len(pending[-1])
        while size > LIMIT:
            size -= len(pending.popleft())
        if size >= BATCH_SIZE or urgent:
            lock.notify()

def publish():
    global size, urgent
    while True:
        with lock:
            deadline = time.monotonic() + INTERVAL
            while size < BATCH_SIZE and not urgent:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    break
                lock.wait(remaining)
            batch = b''.join(pending)
            pending.clear()
            size = 0
            urgent = False
        if not batch:
            continue
        try:
            result = subprocess.run(['/usr/libexec/sp11-log-collector', 'live-append'],
                                    input=batch, timeout=180, check=False)
            if result.returncode:
                print("sp11-kmsg-tail: publish failed; retrying", file=sys.stderr, flush=True)
                add(batch, retry=True)
                time.sleep(INTERVAL)
        except (OSError, subprocess.TimeoutExpired) as exc:
            print('sp11-kmsg-tail: publish failed:', exc, file=sys.stderr, flush=True)
            add(batch, retry=True)
            time.sleep(INTERVAL)

threading.Thread(target=publish, daemon=True).start()
fd = os.open('/dev/kmsg', os.O_RDONLY | os.O_NONBLOCK)
poll = select.poll()
poll.register(fd, select.POLLIN)
while True:
    poll.poll()
    try:
        data = os.read(fd, 65536)
        if data:
            add(data.rstrip(b'\n') + b'\n')
    except BlockingIOError:
        pass
    except OSError as exc:
        # EPIPE reports records overwritten in the kernel ring.
        print('sp11-kmsg-tail: kmsg read:', exc, file=sys.stderr, flush=True)
        add(('sp11-kmsg-tail: kmsg read: %s\n' % exc).encode())
