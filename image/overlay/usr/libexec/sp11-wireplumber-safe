#!/bin/sh
# Safe entry and the GPU-less debug entry: WirePlumber's libcamera plugin
# reaches SoftISP through Mesa. Under TCG/GPU-off the front IMX681
# configuration crashed in llvmpipe (llvm_pipeline_generic). Force the non-LLVM
# software rasteriser whenever the GPU is not usable:
#   - sp11.entry=safe (GPU node disabled in the m15-safe DTB);
#   - sp11.test=test-safe-debug;
#   - msm.skip_gpu=1 (the debug entry keeps the GPU node but registers no GPU
#     driver: without this, the camera stack tries the GPU path and hangs).
# With the GPU enabled (msm.skip_gpu=0, GPU experiment) the GPU path is kept.
cmdline=${SP11_CMDLINE_FILE:-/proc/cmdline}
case " $(cat "$cmdline" 2>/dev/null) " in
    *' sp11.entry=safe '* | *' sp11.test=test-safe-debug '* | *' msm.skip_gpu=1 '*)
        export GALLIUM_DRIVER=softpipe
        export LIBGL_ALWAYS_SOFTWARE=1
        ;;
esac
exec "${SP11_WIREPLUMBER:-/usr/bin/wireplumber}" "$@"
