#!/bin/sh
# Safe entry: WirePlumber's libcamera plugin reaches SoftISP through Mesa.
# Under TCG/GPU-off, the front IMX681 configuration crashed in llvmpipe
# (llvm_pipeline_generic).  Force the non-LLVM software rasterizer only on the
# safe entry; the debug entry keeps the GPU path.
case " $(cat /proc/cmdline) " in
    *' sp11.entry=safe '*)
        export GALLIUM_DRIVER=softpipe
        export LIBGL_ALWAYS_SOFTWARE=1
        ;;
esac
exec /usr/bin/wireplumber "$@"
