#!/usr/bin/python3
"""Read iptsd logs or libinput device names without exporting identifiers."""
import re
import subprocess
import sys


def redact(text):
    text = re.sub(r"(?i)(?<![0-9a-f])(?:[0-9a-f]{2}[:-]){5}[0-9a-f]{2}(?![0-9a-f])",
                  "[masked-address]", text)
    return re.sub(r'''(?ix)\b(serial(?:[_\ -]?(?:number|no))?|uniq(?:ue)?)
                     \s*[:=]\s*(?:"[^"]*"|'[^']*'|\S+)''',
                  r"\1=[masked]", text)


def collect(kind):
    command = (["journalctl", "-b", "--no-pager", "-o", "short-monotonic", "-u", "iptsd@*.service"]
               if kind == "journal" else ["libinput", "list-devices"])
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=20, check=False)
    except (OSError, subprocess.TimeoutExpired):
        print("<capture unavailable>")
        return 1
    if result.returncode:
        print(f"<capture failed: exit {result.returncode}>")
        return 1
    if kind == "journal":
        print(redact(result.stdout).strip() or "<no iptsd journal entries>")
    else:
        # Only Device fields: no Kernel, Group, Seat, device properties or udev IDs.
        names = [redact(line.partition(":")[2].strip())
                 for line in result.stdout.splitlines() if line.startswith("Device:")]
        print("\n".join(names) or "<no device names>")
    return 0


if __name__ == "__main__":
    if sys.argv[1:] not in (["journal"], ["devices"]):
        sys.exit("usage: sp11-touch-userspace-collect journal|devices")
    sys.exit(collect(sys.argv[1]))
