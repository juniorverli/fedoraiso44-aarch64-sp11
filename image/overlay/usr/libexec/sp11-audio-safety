#!/usr/bin/bash
# D28: mute built-in sinks before graphical-session.target; timeout/failure is visible in the user journal.
# Matches sink node names containing the ALSA platform-card prefix alsa_output.platform-sound; runtime name remains to be confirmed.
set -euo pipefail
for _ in $(seq 1 300); do
	status=$(wpctl status -n 2>/dev/null || true)
	ids=$(printf '%s\n' "$status" | awk '/alsa_output\.platform-sound/ { if (match($0, /[0-9]+\./)) print substr($0, RSTART, RLENGTH-1) }' | sort -u)
	if [ -n "$ids" ]; then
		for id in $ids; do
			wpctl set-mute "$id" 1 >/dev/null
			wpctl set-volume "$id" 100% >/dev/null
		done
		exit 0
	fi
	sleep 0.1
done
echo 'sp11-audio-safety: no built-in sink appeared before timeout' >&2
exit 1
