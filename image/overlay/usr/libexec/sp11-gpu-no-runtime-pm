#!/bin/bash
# Debug-only diagnostic: pin the Adreno platform device active for this boot.
set -u
for ((attempt=0; attempt<30; attempt++)); do
    for device in /sys/bus/platform/devices/3d00000.gpu /sys/bus/platform/drivers/adreno/*; do
        [ -d "$device" ] || continue
        [ "${device##*/}" = 3d00000.gpu ] || [ "$(basename "$(readlink -f "$device/driver" 2>/dev/null)")" = adreno ] || continue
        if [ -w "$device/power/control" ]; then
            printf 'on\n' > "$device/power/control" && { echo "GPU runtime PM disabled for $device"; exit 0; }
        fi
    done
    sleep 1
done
echo 'Adreno platform device or power/control unavailable after 30 seconds' >&2
exit 1
