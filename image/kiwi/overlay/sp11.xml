<?xml version="1.0" encoding="utf-8"?>
<!--
  SP11 layer on top of Fedora's kiwi description (decision D16). Included from Fedora.kiwi by
  image/kiwi/patches/0001-include-sp11-layer.patch. Everything SP11-specific that fits an XML
  fragment is here; the rest is listed in image/README.md, "kiwi layer".
  Profile: Workstation-Live (the profile Fedora builds for its official Workstation live ISO).
-->
<image>
	<!-- SP11 change 1: our kernel RPMs, built by the kernel worker, served by a local repository
	     (out/repo, created by scripts/image-build.sh). Priority 10 beats the Fedora repositories
	     (default 99): for every package name the local repository provides, dnf5 takes the local
	     one even if Fedora's version is newer. Fedora's kernel is thereby excluded. -->
	<repository type="rpm-md" alias="sp11-local" priority="10" imageinclude="false"
	            package_gpgcheck="false" repository_gpgcheck="false" profiles="Workstation-Live">
		<source path="dir:///out/repo"/>
	</repository>

	<packages type="image" patternType="plusRecommended" profiles="Workstation-Live">
		<!-- SP11 change 2: firmware. The DriverStore blobs come from out/firmware-root through
		     the root overlay; qcom-firmware and linux-firmware carry the rest (qcom/gen70500_*). -->
		<package name="qcom-firmware"/>
		<package name="linux-firmware"/>

		<!-- SP11 change 5: test and debugging packages of the M2 kickstart -->
		<package name="mesa-dri-drivers"/>
		<package name="mesa-vulkan-drivers"/>
		<package name="vulkan-tools"/>
		<package name="glx-utils"/>
		<package name="glmark2"/>
		<package name="drm-utils"/>
		<package name="v4l-utils"/>
		<package name="qrtr"/>
		<!-- M14 (d), npu/sensors Requests: Fedora's FastRPC runtime and daemons. Its udev rule gives the device nodes to root:fastrpc 0640
		     (no 0666, no image rule). A test transaction with qrtr completes (image/component-inputs/m15.json). No QAIRT. -->
		<package name="fastrpc"/>
		<package name="fastrpc-services"/>
		<!-- M15 integration (sensors dossier build evidence section 6): the five local sensor RPMs of out/rpms-local, served by the local repository with priority 10
		     (iio-sensor-proxy 3.9 with SSC replaces Fedora's 3.8). Units, udev rules (fastrpc group 0660, never 0666) and the collector drop-in come from sp11-sensors;
		     adsprpcd* is NOT masked. The Windows-derived data is private-mode only. -->
		<package name="hexagonrpcd"/>
		<package name="libssc"/>
		<package name="libssc-tools"/>
		<package name="iio-sensor-proxy"/>
		<package name="sp11-sensors"/>
		<!-- M15 integration (audio-mics Requests and quality-parity Asks): alsaucm for the collector and the route layer, the limiter (ladspa-swh-plugins, Fedora's
		     name of the swh-plugins source) and WebRTC audio processing for the private PipeWire quality configs; pipewire's own libs carry filter-chain and echo-cancel. -->
		<package name="alsa-ucm-utils"/>
		<package name="pipewire-utils"/>
		<package name="alsa-utils"/>
		<package name="ladspa-swh-plugins"/>
		<package name="webrtc-audio-processing"/>
		<!-- M15 integration (Spectra test entry): the out-of-tree downstream camera module, built against this kernel-devel; loaded only by sp11-spectra-load.service -->
		<package name="sp11-camera-spectra"/>
		<package name="dtc"/>
		<package name="pciutils"/>
		<package name="usbutils"/>
		<package name="bpftool"/>
		<package name="mtools"/>
		<package name="dosfstools"/>
		<!-- ec-sam R3 and Bluetooth boot-time configuration / masked capture. -->
		<package name="libinput-utils"/>
		<package name="evtest"/>
		<!-- M13 (cameras R4): libcamera with the RGB software ISP, and cam/qcam. M15: the local build of Fedora's libcamera 0.7.2 source package plus the cameras
		     owner's two patches (gamma key, OV13858 black level, IMX681 helper) wins in the local repository when out/rpms-local/libcamera exists (scripts/image-build-libcamera.sh);
		     otherwise Fedora's stock package is installed. The tuning YAMLs are private-mode data. -->
		<package name="libcamera"/>
		<package name="libcamera-tools"/>
		<!-- Local Fedora-native RPM; upstream udev rule activates iptsd@.service. -->
		<package name="iptsd"/>
		<package name="bluez"/>
		<!-- SP11 change 4/5: ausearch for the SELinux AVC capture of the log collector (D15) -->
		<package name="audit"/>

		<!-- SP11 change 3: no splash screen (D9). Plymouth stays installed: Fedora's GNOME/Workstation
		     package groups require it, and excluding it makes dnf5 fail ("Argument 'plymouth' matches
		     only excluded packages"). It is switched off instead: omitted from the initramfs
		     (root/etc/dracut.conf.d/90-sp11.conf), rd.plymouth=0 plymouth.enable=0 on every entry,
		     and its units masked (scripts/image-build-kiwi.sh). -->
	</packages>
	<packages type="delete" profiles="Workstation-Live">
		<!-- SP11: keep the live image basic; the office suite is not part of it. -->
		<package name="libreoffice-calc"/>
		<package name="libreoffice-core"/>
		<package name="libreoffice-data"/>
		<package name="libreoffice-emailmerge"/>
		<package name="libreoffice-filters"/>
		<package name="libreoffice-graphicfilter"/>
		<package name="libreoffice-gtk3"/>
		<package name="libreoffice-gtk4"/>
		<package name="libreoffice-help-en"/>
		<package name="libreoffice-impress"/>
		<package name="libreoffice-langpack-en"/>
		<package name="libreoffice-ogltrans"/>
		<package name="libreoffice-opensymbol-fonts"/>
		<package name="libreoffice-pdfimport"/>
		<package name="libreoffice-pyuno"/>
		<package name="libreoffice-ure"/>
		<package name="libreoffice-ure-common"/>
		<package name="libreoffice-writer"/>
		<package name="libreoffice-xsltfilter"/>
	</packages>
</image>
