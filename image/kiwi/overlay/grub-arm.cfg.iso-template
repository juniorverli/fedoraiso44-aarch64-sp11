# SP11 GRUB 2 configuration of the live ISO (decisions D9, D10, D15, D16).
#
# Replaces grub-arm.cfg.iso-template of fedora-kiwi-descriptions (branch f44, commit in
# image/kiwi/DESCRIPTION_COMMIT), which is "inspired by the config used for lorax-built live
# media": same header (load_video, modules), same `search`, same kernel/initrd line shape.
# Differences, all listed in image/README.md ("kiwi layer", change 3):
#   - load_video keeps efi_gop and all_video only: efi_uga, video_bochs and video_cirrus do not exist
#     on arm64-efi (QEMU printed "file not found" for each; they are x86 modules in Fedora's template);
#   - no `Test this media` and no `Troubleshooting` submenu; the M15 menu is FLAT and STATIC like M13 (image/README.md, "M15"): the M14 experience
#     (a GRUB function, load_env/save_env on the ESP grubenv, variable DTB and arguments) failed with EFI_LOAD_ERROR on the device while the
#     static `safe` entry booted, so this file has NO function except load_video, NO grubenv, NO variable, NO submenu; every entry has a fixed DTB;
#   - `set default=1` and timeout_style=menu with a fixed timeout: the menu is always shown;
#   - every device entry has a `devicetree` line (GRUB 2 command, D9); the VM test entry has none;
#     every device entry names an M15 DTB: m15 (microphones + rear/front/IR camera nodes + GPU/GMU/zap, the content of the former m14.dtb) on line 1,
#     m15-safe (microphones and cameras on, GPU off) on line 2 as the default; speakers only in the `spk`
#     entry (m15-spk, D26 profile); there is no separate GPU or camera entry except the Spectra test entry (m15-spectra, module_blacklist=camera_x1e80100);
#   - every entry has sp11.entry=<id>; only the VM entry adds the serial console (D15);
#   - the common kernel arguments are kiwi's boot options: its live options (root=live:CDLABEL, rd.live.image)
#     plus the verbose kernelcmdline patched into components/liveinstall.xml (patch 0002).
# This file is a Python string.Template of kiwi, so a double dollar sign stands for a GRUB dollar sign.
# The build script and image-test-static.sh fail when a forbidden boot word (see README) reaches any grub.cfg.

function load_video {
	insmod efi_gop
	insmod all_video
}

load_video
set gfxpayload=keep
insmod gzio
insmod part_gpt
insmod ext2

terminal_input console
terminal_output ${terminal_output}

# Menu always shown, never hidden, never skipped.
set timeout=${boot_timeout}
set timeout_style=menu
set default=1

search ${search_params}
# M15 (kernel 7.3.0-65.sp11.12): flat static menu, M13 style. Every entry is fixed text; GRUB reads no state and writes none.
# Line 1 enables the GPU with the m15 DTB. The first DRM open may reset the machine; line 2 defaults to m15-safe (GPU off).
# The GPU two-step is opt-in: add sp11.gpu_diag=1 manually for a controlled test, which may reset the machine.
# Experiments that used GRUB state in M14 (SAM shutdown rotor, CDSP firmware/proxy-vote rotor, GPU two-step) run in Linux userspace with
# their state in plain files on the boot medium (image/README.md, "M15"). The GPU two-step markers are plain files too; GRUB has no GPU logic.
# S1: the only DTB that enables the speaker sound card is m15-spk, only in the `spk` entry, checked against the d26 profile by L0.
menuentry 'SP11 debug' --id sp11-debug --class fedora --class gnu-linux --class gnu --class os {
	linux ($$root)${bootpath}/${kernel_file} ${boot_options} clk_ignore_unused pd_ignore_unused rootdelay=10 rd.driver.blacklist=qcom_battmgr modprobe.blacklist=qcom_battmgr pmic_glink_altmode.dyndbg=+p ps883x.dyndbg=+p phy_qcom_qmp_combo.dyndbg=+p ucsi_glink.dyndbg=+p typec_ucsi.dyndbg=+p dwc3.dyndbg=+p dwc3_qcom.dyndbg=+p qcom_pd_mapper.dyndbg=+p pdr_interface.dyndbg=+p trace_event=:mod:qcom_glink,:mod:smp2p,:mod:qcom_aoss,rpmh:rpmh_send_msg trace_buf_size=16M efi_pstore.pstore_disable=0 printk.always_kmsg_dump=1 msm.skip_gpu=1 sp11.entry=debug
	devicetree ($$root)/boot/dtb/qcom/x1p64100-microsoft-denali-m15.dtb
	initrd ($$root)${bootpath}/${initrd_file}
}
menuentry 'SP11 debug, safe (no GPU)' --id sp11-safe --class fedora --class gnu-linux --class gnu --class os {
	linux ($$root)${bootpath}/${kernel_file} ${boot_options} clk_ignore_unused pd_ignore_unused rootdelay=10 rd.driver.blacklist=qcom_battmgr modprobe.blacklist=qcom_battmgr pmic_glink_altmode.dyndbg=+p ps883x.dyndbg=+p phy_qcom_qmp_combo.dyndbg=+p ucsi_glink.dyndbg=+p typec_ucsi.dyndbg=+p dwc3.dyndbg=+p dwc3_qcom.dyndbg=+p qcom_pd_mapper.dyndbg=+p pdr_interface.dyndbg=+p trace_event=:mod:qcom_glink,:mod:smp2p,:mod:qcom_aoss,rpmh:rpmh_send_msg trace_buf_size=16M sp11.entry=safe
	devicetree ($$root)/boot/dtb/qcom/x1p64100-microsoft-denali-m15-safe.dtb
	initrd ($$root)${bootpath}/${initrd_file}
}
