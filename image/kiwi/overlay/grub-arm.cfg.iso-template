menuentry 'SP11 debug, speakers (closed-loop experiment; private)' --id sp11-spk --class fedora --class gnu-linux --class gnu --class os {
	# Closed-loop experiment only: m15-spk must select the CL sound model. Public images have no CL file and must fail closed.
	# sp11.allow_nominal=1 here and nowhere else. Kill switch: press e and add `sp11.nospk` to the linux line, or power off.
	echo 'SP11 speaker FIRST TEST: minimum volume, tones of at most 2 s, 3 min of silence between tones, at most 10 tones, any fault ends the session (power off).'
	echo 'Unproven: ADSP cross-graph control link and capture graph with an unconnected input. If either fails the guard stays closed and the speakers stay muted.'
	echo 'Kill switch: press e now and add sp11.nospk to the linux line. Run sp11-speaker-first-test as root, never automatically.'
	sleep 3
	linux ($$root)${bootpath}/${kernel_file} ${boot_options} clk_ignore_unused pd_ignore_unused rootdelay=10 rd.driver.blacklist=qcom_battmgr modprobe.blacklist=qcom_battmgr pmic_glink_altmode.dyndbg=+p ps883x.dyndbg=+p phy_qcom_qmp_combo.dyndbg=+p ucsi_glink.dyndbg=+p typec_ucsi.dyndbg=+p dwc3.dyndbg=+p dwc3_qcom.dyndbg=+p qcom_pd_mapper.dyndbg=+p pdr_interface.dyndbg=+p trace_event=:mod:qcom_glink,:mod:smp2p,:mod:qcom_aoss,rpmh:rpmh_send_msg trace_buf_size=16M sp11.allow_nominal=1 sp11.entry=spk
	devicetree ($$root)/boot/dtb/qcom/x1p64100-microsoft-denali-m15-spk.dtb
	initrd ($$root)${bootpath}/${initrd_file}
}
