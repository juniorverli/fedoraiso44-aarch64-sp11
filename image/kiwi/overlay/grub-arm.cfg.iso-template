# SP11 GRUB 2 configuration of the live ISO (decisions D9, D10, D15, D16).
#
# Replaces grub-arm.cfg.iso-template of fedora-kiwi-descriptions (branch f44, commit in
# image/kiwi/DESCRIPTION_COMMIT), which is "inspired by the config used for lorax-built live
# media": same header (load_video, modules), same `search`, same kernel/initrd line shape.
# Differences, all listed in image/README.md ("kiwi layer", change 3):
#   - load_video keeps efi_gop and all_video only: efi_uga, video_bochs and video_cirrus do not exist
#     on arm64-efi (QEMU printed "file not found" for each; they are x86 modules in Fedora's template);
#   - no `Test this media` and no `Troubleshooting` submenu; the nine SP11 entries of D19 and M4 instead;
#   - `set default=0` and timeout_style=menu with a fixed timeout: the menu is always shown;
#   - every device entry has a `devicetree` line (GRUB 2 command, D9); the VM test entry has none;
#     four DTBs sit next to each other on the ISO: the packaged one, `-parity` (M4), `-edponly` and `-nobl` (D19);
#   - every entry has sp11.entry=<id>; only the VM entry adds the serial console (D15);
#   - the common kernel arguments are kiwi's boot options: its live options (root=live:CDLABEL, rd.live.image)
#     plus the verbose kernelcmdline patched into components/liveinstall.xml (patch 0002).
# This file is a Python string.Template of kiwi, so a double dollar sign stands for a GRUB dollar sign.
# The build script and image-test-static.sh fail when a forbidden boot word (see README) reaches any grub.cfg.

function load_video {
	insmod efi_gop
	insmod all_video
}

load_video
set gfxpayload=keep
insmod gzio
insmod part_gpt
insmod ext2

terminal_input console
terminal_output ${terminal_output}

# Menu always shown, never hidden, never skipped.
set timeout=${boot_timeout}
set timeout_style=menu
set default=0

search ${search_params}

# 1. Default: packaged DTB.
menuentry 'SP11 debug' --id sp11-debug --class fedora --class gnu-linux --class gnu --class os {
	linux ($$root)${bootpath}/${kernel_file} ${boot_options} sp11.entry=debug
	devicetree ($$root)/boot/dtb/qcom/x1p64100-microsoft-denali.dtb
	initrd ($$root)${bootpath}/${initrd_file}
}
# 2. M4: parity with the old project, which reached GNOME on this Surface (surface-compare report 2c, 2e): the
# clocks and power domains kept, rootdelay=10, and its DT shape (10-CPU topology, no system SS3 idle) in the
# -parity DTB on top of the M3 DT. SP11 debug stays the default (D19 gate).
menuentry 'SP11 debug, old-project parity' --id sp11-parity --class fedora --class gnu-linux --class gnu --class os {
	linux ($$root)${bootpath}/${kernel_file} ${boot_options} clk_ignore_unused pd_ignore_unused rootdelay=10 sp11.entry=parity
	devicetree ($$root)/boot/dtb/qcom/x1p64100-microsoft-denali-parity.dtb
	initrd ($$root)${bootpath}/${initrd_file}
}
# 3. D19 H1: keep the clocks and power domains the firmware left on. Diagnostic, never the default.
menuentry 'SP11 debug, keep firmware clocks' --id sp11-keepclk --class fedora --class gnu-linux --class gnu --class os {
	linux ($$root)${bootpath}/${kernel_file} ${boot_options} clk_ignore_unused pd_ignore_unused sp11.entry=keepclk
	devicetree ($$root)/boot/dtb/qcom/x1p64100-microsoft-denali.dtb
	initrd ($$root)${bootpath}/${initrd_file}
}
# 4. D19 H5: external USB-C DP0/DP1 disabled in the DT, so a DP bridge chain that never probes cannot hold msm back.
menuentry 'SP11 debug, eDP only (USB-C DP off)' --id sp11-edponly --class fedora --class gnu-linux --class gnu --class os {
	linux ($$root)${bootpath}/${kernel_file} ${boot_options} sp11.entry=edponly
	devicetree ($$root)/boot/dtb/qcom/x1p64100-microsoft-denali-edponly.dtb
	initrd ($$root)${bootpath}/${initrd_file}
}
# 5. D19 H3: DTB without the PWM backlight patch (display-lcd 0003).
menuentry 'SP11 debug, DTB without PWM backlight' --id sp11-nobl --class fedora --class gnu-linux --class gnu --class os {
	linux ($$root)${bootpath}/${kernel_file} ${boot_options} sp11.entry=nobl
	devicetree ($$root)/boot/dtb/qcom/x1p64100-microsoft-denali-nobl.dtb
	initrd ($$root)${bootpath}/${initrd_file}
}
menuentry 'SP11 debug + DRM trace' --id sp11-drm-trace --class fedora --class gnu-linux --class gnu --class os {
	linux ($$root)${bootpath}/${kernel_file} ${boot_options} drm.debug=0x1ff sp11.entry=drm-trace
	devicetree ($$root)/boot/dtb/qcom/x1p64100-microsoft-denali.dtb
	initrd ($$root)${bootpath}/${initrd_file}
}
menuentry 'SP11 debug nomodeset' --id sp11-nomodeset --class fedora --class gnu-linux --class gnu --class os {
	linux ($$root)${bootpath}/${kernel_file} ${boot_options} nomodeset sp11.entry=nomodeset
	devicetree ($$root)/boot/dtb/qcom/x1p64100-microsoft-denali.dtb
	initrd ($$root)${bootpath}/${initrd_file}
}
menuentry 'SP11 debug, stop in initramfs' --id sp11-initramfs --class fedora --class gnu-linux --class gnu --class os {
	linux ($$root)${bootpath}/${kernel_file} ${boot_options} rd.break=pre-mount sp11.entry=initramfs
	devicetree ($$root)/boot/dtb/qcom/x1p64100-microsoft-denali.dtb
	initrd ($$root)${bootpath}/${initrd_file}
}
# L1 only (QEMU virt): same kernel, no devicetree, so the firmware description is used.
# Serial console last so that systemd status and the L1 test see it on /dev/console.
menuentry 'VM test (no devicetree)' --id sp11-vmtest --class fedora --class gnu-linux --class gnu --class os {
	linux ($$root)${bootpath}/${kernel_file} ${boot_options} console=ttyAMA0,115200 sp11.entry=vmtest
	initrd ($$root)${bootpath}/${initrd_file}
}
