menuentry 'SP11 debug, Spectra camera test' --id sp11-spectra --class fedora --class gnu-linux --class gnu --class os {
	# Qualcomm Spectra camera path test (hardware/cameras/evidence/2026-10-31-spectra-integration.md): m15-spectra DTB, the same static arguments as `safe`,
	# and module_blacklist=camera_x1e80100 so the downstream module never loads from GRUB's choice. Linux loads it only when the marker file
	# /sp11/spectra-load exists on the boot medium (sp11-spectra-load.service). Never the main entry.
	linux ($$root)${bootpath}/${kernel_file} ${boot_options} clk_ignore_unused pd_ignore_unused rootdelay=10 rd.driver.blacklist=qcom_battmgr modprobe.blacklist=qcom_battmgr pmic_glink_altmode.dyndbg=+p ps883x.dyndbg=+p phy_qcom_qmp_combo.dyndbg=+p ucsi_glink.dyndbg=+p typec_ucsi.dyndbg=+p dwc3.dyndbg=+p dwc3_qcom.dyndbg=+p qcom_pd_mapper.dyndbg=+p pdr_interface.dyndbg=+p trace_event=:mod:qcom_glink,:mod:smp2p,:mod:qcom_aoss,rpmh:rpmh_send_msg trace_buf_size=16M module_blacklist=camera_x1e80100 sp11.entry=spectra
	devicetree ($$root)/boot/dtb/qcom/x1p64100-microsoft-denali-m15-spectra.dtb
	initrd ($$root)${bootpath}/${initrd_file}
}
# Rev25 debug isolation matrix: one variable per boot. Every entry below is the line-1 debug entry (same m15 DTB, GPU on, EFI pstore,
# USB/PDR dyndbg and DSP trace) plus exactly one test argument; sp11.entry stays `debug` so the debug-only GPU pin, kmsg tail and
# GPU state hooks behave exactly as on line 1, and sp11.test=<id> names the test. Do not add two variables to one entry.
menuentry 'SP11 debug, test multi-user (no GNOME)' --id sp11-test-multi-user --class fedora --class gnu-linux --class gnu --class os {
	linux ($$root)${bootpath}/${kernel_file} ${boot_options} clk_ignore_unused pd_ignore_unused rootdelay=10 rd.driver.blacklist=qcom_battmgr modprobe.blacklist=qcom_battmgr pmic_glink_altmode.dyndbg=+p ps883x.dyndbg=+p phy_qcom_qmp_combo.dyndbg=+p ucsi_glink.dyndbg=+p typec_ucsi.dyndbg=+p dwc3.dyndbg=+p dwc3_qcom.dyndbg=+p qcom_pd_mapper.dyndbg=+p pdr_interface.dyndbg=+p trace_event=:mod:qcom_glink,:mod:smp2p,:mod:qcom_aoss,rpmh:rpmh_send_msg trace_buf_size=16M efi_pstore.pstore_disable=0 printk.always_kmsg_dump=1 systemd.unit=multi-user.target sp11.test=test-multi-user sp11.entry=debug
	devicetree ($$root)/boot/dtb/qcom/x1p64100-microsoft-denali-m15.dtb
	initrd ($$root)${bootpath}/${initrd_file}
}
