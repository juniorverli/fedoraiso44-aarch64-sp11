# SP11 GRUB 2 configuration of the live ISO (decisions D9, D10, D15, D16).
#
# Replaces grub-arm.cfg.iso-template of fedora-kiwi-descriptions (branch f44, commit in
# image/kiwi/DESCRIPTION_COMMIT), which is "inspired by the config used for lorax-built live
# media": same header (load_video, modules), same `search`, same kernel/initrd line shape.
# Differences, all listed in image/README.md ("kiwi layer", change 3):
#   - load_video keeps efi_gop and all_video only: efi_uga, video_bochs and video_cirrus do not exist
#     on arm64-efi (QEMU printed "file not found" for each; they are x86 modules in Fedora's template);
#   - no `Test this media` and no `Troubleshooting` submenu; the sixteen M13 entries (D26, image/README.md "M13 private ISO") instead;
#   - `set default=0` and timeout_style=menu with a fixed timeout: the menu is always shown;
#   - every device entry has a `devicetree` line (GRUB 2 command, D9); the VM test entry has none;
#     every device entry names an M13 DTB: m13 (microphones) by default; speakers only in the `spk` entry (m13-spk, D26 profile), GPU only in `gpu-diag` (m13-gpu);
#   - every entry has sp11.entry=<id>; only the VM entry adds the serial console (D15);
#   - the common kernel arguments are kiwi's boot options: its live options (root=live:CDLABEL, rd.live.image)
#     plus the verbose kernelcmdline patched into components/liveinstall.xml (patch 0002).
# This file is a Python string.Template of kiwi, so a double dollar sign stands for a GRUB dollar sign.
# The build script and image-test-static.sh fail when a forbidden boot word (see README) reaches any grub.cfg.

function load_video {
	insmod efi_gop
	insmod all_video
}

load_video
set gfxpayload=keep
insmod gzio
insmod part_gpt
insmod ext2

terminal_input console
terminal_output ${terminal_output}

# Menu always shown, never hidden, never skipped.
set timeout=${boot_timeout}
set timeout_style=menu
set default=0

search ${search_params}
# M13 (series revision 10, kernel 7.3.0-65.sp11.10): default = m13 (microphones; WSA speakers and GPU off, camera chain disabled).
# Every device entry from 1 to 9 carries the same diagnostic arguments (USB dynamic debug, PDR dynamic debug, the corrected DSP
# trace string of dsp-subsystems R-K4/R-I5) so any entry produces comparable evidence; entries 4-7 add one kernel parameter each.
# S1: the only DTB that enables the speaker sound card is m13-spk, only in the `spk` entry, checked against the d26 profile by L0.
# The kernel gate (audio-speakers 0009) still refuses WSA playback in this build. The GPU DTB is only in the last device entry.
menuentry 'SP11 debug' --id sp11-debug --class fedora --class gnu-linux --class gnu --class os {
	linux ($$root)${bootpath}/${kernel_file} ${boot_options} clk_ignore_unused pd_ignore_unused rootdelay=10 rd.driver.blacklist=qcom_battmgr modprobe.blacklist=qcom_battmgr pmic_glink_altmode.dyndbg=+p ps883x.dyndbg=+p phy_qcom_qmp_combo.dyndbg=+p ucsi_glink.dyndbg=+p typec_ucsi.dyndbg=+p dwc3.dyndbg=+p dwc3_qcom.dyndbg=+p qcom_pd_mapper.dyndbg=+p pdr_interface.dyndbg=+p trace_event=:mod:qcom_glink,:mod:smp2p,:mod:qcom_aoss,rpmh:rpmh_send_msg,power:power_domain_target trace_buf_size=16M sp11.entry=debug
	devicetree ($$root)/boot/dtb/qcom/x1p64100-microsoft-denali-m13.dtb
	initrd ($$root)${bootpath}/${initrd_file}
}
menuentry 'SP11 debug, no sound' --id sp11-nosnd --class fedora --class gnu-linux --class gnu --class os {
	linux ($$root)${bootpath}/${kernel_file} ${boot_options} clk_ignore_unused pd_ignore_unused rootdelay=10 rd.driver.blacklist=qcom_battmgr modprobe.blacklist=qcom_battmgr pmic_glink_altmode.dyndbg=+p ps883x.dyndbg=+p phy_qcom_qmp_combo.dyndbg=+p ucsi_glink.dyndbg=+p typec_ucsi.dyndbg=+p dwc3.dyndbg=+p dwc3_qcom.dyndbg=+p qcom_pd_mapper.dyndbg=+p pdr_interface.dyndbg=+p trace_event=:mod:qcom_glink,:mod:smp2p,:mod:qcom_aoss,rpmh:rpmh_send_msg,power:power_domain_target trace_buf_size=16M sp11.entry=nosnd
	devicetree ($$root)/boot/dtb/qcom/x1p64100-microsoft-denali-m13-nosnd.dtb
	initrd ($$root)${bootpath}/${initrd_file}
}
