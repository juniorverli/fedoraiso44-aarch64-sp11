# SP11 GRUB 2 configuration of the live ISO (decisions D9, D10, D15, D16).
#
# Replaces grub-arm.cfg.iso-template of fedora-kiwi-descriptions (branch f44, commit in
# image/kiwi/DESCRIPTION_COMMIT), which is "inspired by the config used for lorax-built live
# media": same header (load_video, modules), same `search`, same kernel/initrd line shape.
# Differences, all listed in image/README.md ("kiwi layer", change 3):
#   - load_video keeps efi_gop and all_video only: efi_uga, video_bochs and video_cirrus do not exist
#     on arm64-efi (QEMU printed "file not found" for each; they are x86 modules in Fedora's template);
#   - no `Test this media` and no `Troubleshooting` submenu; the menu is FLAT and STATIC (image/README.md, "M15"):
#     NO function except load_video, NO grubenv, NO variable, NO submenu; every device entry has a fixed DTB;
#   - three entries only: the full debug delivery, the live installer and the VM entry the automated L1 uses;
#     `set default=0`: the debug entry boots by default and carries the closed-loop audio (m15-cl, allow_nominal);
#   - every device entry has a `devicetree` line (GRUB 2 command, D9); the VM test entry has none;
#   - every entry has sp11.entry=<id>; only the VM entry adds the serial console (D15);
#   - the common kernel arguments are kiwi's boot options: its live options (root=live:CDLABEL, rd.live.image)
#     plus the verbose kernelcmdline patched into components/liveinstall.xml (patch 0002).
# This file is a Python string.Template of kiwi, so a double dollar sign stands for a GRUB dollar sign.
# The build script and image-test-static.sh fail when a forbidden boot word (see README) reaches any grub.cfg.

function load_video {
	insmod efi_gop
	insmod all_video
}

load_video
set gfxpayload=keep
insmod gzio
insmod part_gpt
insmod ext2

terminal_input console
terminal_output ${terminal_output}

# Menu always shown, never hidden, never skipped.
set timeout=${boot_timeout}
set timeout_style=menu
set default=0

search ${search_params}
# Flat static menu, no GRUB state. The debug entry is the full delivery: m15-cl selects the -CL
# sound model (closed-loop topology), sp11.allow_nominal=1 accepts the nominal calibration and
# msm.skip_gpu=1 keeps the Adreno driver from binding (the first DRM open may reset the machine).
# The GPU two-step is opt-in: add sp11.gpu_diag=1 manually for a controlled test.
# Kernel patch 0033 refuses speaker playback on any topology without the SP module, so only the
# -CL entries can produce speaker sound; both device entries use the -CL model.
menuentry 'SP11 debug' --id sp11-debug --class fedora --class gnu-linux --class gnu --class os {
	linux ($$root)${bootpath}/${kernel_file} ${boot_options} clk_ignore_unused pd_ignore_unused rootdelay=10 rd.driver.blacklist=qcom_battmgr modprobe.blacklist=qcom_battmgr pmic_glink_altmode.dyndbg=+p ps883x.dyndbg=+p phy_qcom_qmp_combo.dyndbg=+p ucsi_glink.dyndbg=+p typec_ucsi.dyndbg=+p dwc3.dyndbg=+p dwc3_qcom.dyndbg=+p qcom_pd_mapper.dyndbg=+p pdr_interface.dyndbg=+p trace_event=:mod:qcom_glink,:mod:smp2p,:mod:qcom_aoss,rpmh:rpmh_send_msg trace_buf_size=16M sp11.allow_nominal=1 efi_pstore.pstore_disable=0 printk.always_kmsg_dump=1 msm.skip_gpu=1 sp11.entry=debug
	devicetree ($$root)/boot/dtb/qcom/x1p64100-microsoft-denali-m15-cl.dtb
	initrd ($$root)${bootpath}/${initrd_file}
}
menuentry 'SP11 live, install from the desktop (keeps Windows)' --id sp11-install --class fedora --class gnu-linux --class gnu --class os {
	# Anaconda refuses inst.ks on a live install ("kickstart is not supported on live iso
	# installs"), so this entry boots the live system. Install with "Install to Hard Drive"
	# from the desktop, choose the Windows disk and "Install alongside"; sp11-first-boot.service
	# finishes the installed system on its first boot (UEFI entry, dual-boot menu,
	# msm.skip_gpu=1, closed-loop audio entry as the default).
	linux ($$root)${bootpath}/${kernel_file} ${boot_options} clk_ignore_unused pd_ignore_unused rootdelay=10 rd.driver.blacklist=qcom_battmgr modprobe.blacklist=qcom_battmgr pmic_glink_altmode.dyndbg=+p ps883x.dyndbg=+p phy_qcom_qmp_combo.dyndbg=+p ucsi_glink.dyndbg=+p typec_ucsi.dyndbg=+p dwc3.dyndbg=+p dwc3_qcom.dyndbg=+p qcom_pd_mapper.dyndbg=+p pdr_interface.dyndbg=+p trace_event=:mod:qcom_glink,:mod:smp2p,:mod:qcom_aoss,rpmh:rpmh_send_msg trace_buf_size=16M sp11.allow_nominal=1 efi_pstore.pstore_disable=0 printk.always_kmsg_dump=1 msm.skip_gpu=1 sp11.entry=safe
	devicetree ($$root)/boot/dtb/qcom/x1p64100-microsoft-denali-m15-cl.dtb
	initrd ($$root)${bootpath}/${initrd_file}
}
menuentry 'VM test (no devicetree)' --id sp11-vmtest --class fedora --class gnu-linux --class gnu --class os {
	linux ($$root)${bootpath}/${kernel_file} ${boot_options} console=ttyAMA0,115200 sp11.entry=vmtest
	initrd ($$root)${bootpath}/${initrd_file}
}
