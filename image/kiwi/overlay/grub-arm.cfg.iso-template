# Rev25b reset-axis isolation: the 7 tests above all kept the m15 DTB, sp11.entry=debug and EFI pstore, so all
# three axes were confounded. These three entries add exactly one axis to a surviving-safe base; the restored
# m15 debug entry is the combined T2. T1 = test-safe-debug + test-safe-pstore; T3 = test-m15-safe.
menuentry 'SP11 debug, test safe DTB + msm off + debug' --id sp11-test-safe-debug --class fedora --class gnu-linux --class gnu --class os {
	linux ($$root)${bootpath}/${kernel_file} ${boot_options} clk_ignore_unused pd_ignore_unused rootdelay=10 rd.driver.blacklist=qcom_battmgr modprobe.blacklist=qcom_battmgr pmic_glink_altmode.dyndbg=+p ps883x.dyndbg=+p phy_qcom_qmp_combo.dyndbg=+p ucsi_glink.dyndbg=+p typec_ucsi.dyndbg=+p dwc3.dyndbg=+p dwc3_qcom.dyndbg=+p qcom_pd_mapper.dyndbg=+p pdr_interface.dyndbg=+p trace_event=:mod:qcom_glink,:mod:smp2p,:mod:qcom_aoss,rpmh:rpmh_send_msg trace_buf_size=16M efi_pstore.pstore_disable=0 printk.always_kmsg_dump=1 module_blacklist=msm sp11.gpu_pin=0 sp11.test=test-safe-debug sp11.entry=debug
	devicetree ($$root)/boot/dtb/qcom/x1p64100-microsoft-denali-m15-safe.dtb
	initrd ($$root)${bootpath}/${initrd_file}
}
