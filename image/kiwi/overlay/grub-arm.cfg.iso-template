menuentry 'SP11 debug, safe, muted closed-loop VI' --id sp11-test-safe-cl --class fedora --class gnu-linux --class gnu --class os {
	linux ($$root)${bootpath}/${kernel_file} ${boot_options} clk_ignore_unused pd_ignore_unused rootdelay=10 rd.driver.blacklist=qcom_battmgr modprobe.blacklist=qcom_battmgr pmic_glink_altmode.dyndbg=+p ps883x.dyndbg=+p phy_qcom_qmp_combo.dyndbg=+p ucsi_glink.dyndbg=+p typec_ucsi.dyndbg=+p dwc3.dyndbg=+p dwc3_qcom.dyndbg=+p qcom_pd_mapper.dyndbg=+p pdr_interface.dyndbg=+p trace_event=:mod:qcom_glink,:mod:smp2p,:mod:qcom_aoss,rpmh:rpmh_send_msg trace_buf_size=16M sp11.nospk=1 sp11.test=test-safe-cl sp11.entry=safe
	devicetree ($$root)/boot/dtb/qcom/x1p64100-microsoft-denali-m15-safe-cl.dtb
	initrd ($$root)${bootpath}/${initrd_file}
