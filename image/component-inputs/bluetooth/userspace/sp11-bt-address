#!/usr/bin/bash
# Configure volatile controller state using Fedora BlueZ. Never provision OTP/NVM.
# The operator supplies the Windows-observed address AFTER writing the ISO.
# No address or machine-identifier-derived fallback is built into the image.
set -euo pipefail
export LC_ALL=C

log() { printf 'sp11-bt-address: %s\n' "$*" >&2; }

controller_matches() {
    # Do not change a USB dongle that happens to get index zero first.
    [[ -r /sys/class/bluetooth/$1/device/of_node/compatible ]] || return 1
    tr '\0' '\n' <"/sys/class/bluetooth/$1/device/of_node/compatible" 2>/dev/null |
        grep -qx 'qcom,wcn7850-bt'
}

valid_address() {
    [[ $1 =~ ^([0-9A-F]{2}:){5}[0-9A-F]{2}$ ]] || return 1
    # These byte arrays are sentinel values, not device identities (S5).
    local compact=${1//:/}
    [[ $compact != 000000000000 && $compact != FFFFFFFFFFFF &&
       $compact != 000000005AAD ]]
}

read_address_file() {
    # Bounded read; accept one address with surrounding whitespace, never shell code.
    [[ -f $1 && -r $1 ]] || return 1
    local value
    value=$(head -c 128 -- "$1")
    value=${value//$'\r'/}
    value=$(sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//' <<<"$value")
    value=${value^^}
    valid_address "$value" || return 1
    addr=$value
}

read_boot_address() (
    # Private subshell: the EXIT trap unmounts even if reading/validation fails.
    # Select a sibling ESP of the mounted live ISO, never a global BOOT label.
    local live syspath disk part dev label type mnt rc=0
    live=$(findmnt -rn -o SOURCE -M /run/initramfs/live) || return 1
    live=$(readlink -e -- "$live") || return 1
    [[ -b $live ]] || return 1
    [[ $(blkid -p -s TYPE -o value "$live" 2>/dev/null) == iso9660 ]] || return 1
    syspath=$(readlink -e "/sys/class/block/${live##*/}") || return 1
    [[ -f $syspath/partition ]] || return 1
    disk=${syspath%/*}
    for part in "$disk"/*; do
        [[ -f $part/partition ]] || continue
        dev=/dev/${part##*/}
        label=$(blkid -p -s LABEL -o value "$dev" 2>/dev/null) || continue
        type=$(blkid -p -s TYPE -o value "$dev" 2>/dev/null) || continue
        [[ $label == BOOT && $type == vfat ]] || continue
        mnt=$(mktemp -d /run/sp11-bt-address.XXXXXX)
        trap 'rc=$?; timeout -k 1 3 umount "$mnt" >/dev/null 2>&1 || rc=1; rmdir "$mnt" 2>/dev/null || true; exit "$rc"' EXIT
        timeout -k 1 3 mount -t vfat -o ro,nosuid,nodev,noexec,umask=0077 "$dev" "$mnt" 2>/dev/null || return 1
        read_address_file "$mnt/EFI/sp11/bt-address" || return 1
        # stdout is captured by the parent; it never reaches the journal.
        printf '%s' "$addr"
        return 0
    done
    return 1
)

config_options() {
    local output supported
    output=$(timeout -k 1 3 btmgmt --timeout 2 --index "$idx" config </dev/null 2>&1) || return 1
    # BlueZ sometimes exits zero after an MGMT error. Require the reply fields.
    [[ $(grep -c '^[[:space:]]*missing options:' <<<"$output") == 1 &&
       $(grep -c '^[[:space:]]*supported options:' <<<"$output") == 1 ]] || return 1
    supported=$(sed -n 's/^[[:space:]]*supported options:[[:space:]]*//p' <<<"$output")
    [[ " $supported " == *' public-address '* ]] || return 1
    missing=$(sed -n 's/^[[:space:]]*missing options:[[:space:]]*//p' <<<"$output" |
        sed -E 's/[[:space:]]+$//')
}

main() {
    local hci=${1:-hci0} idx addr='' missing='' attempt info
    [[ $# -le 2 && $hci == hci0 ]] || { log 'usage: sp11-bt-address [hci0] [local-address-file]'; return 1; }
    idx=${hci#hci}
    controller_matches "$hci" || { log 'WCN7850 controller not found; no change'; return 0; }

    # Device creation precedes the end of firmware setup. Six bounded attempts.
    for attempt in {1..6}; do
        if config_options; then break; fi
        [[ $attempt == 6 ]] && { log 'configuration query unavailable; no change'; return 1; }
        sleep 1
    done
    if [[ -z $missing ]]; then
        log 'controller already configured; no change'
        return 0
    fi
    [[ $missing == public-address ]] || { log 'unexpected missing options; no change'; return 1; }
    log 'controller is missing public-address'

    if [[ $# == 2 || -e /etc/sp11/bt-address ]]; then
        read_address_file "${2:-/etc/sp11/bt-address}" || { log 'local address file invalid or unreadable; no change'; return 1; }
    else
        addr=$(read_boot_address) || { log 'no valid operator address on boot ESP; no change'; return 1; }
    fi
    # No power/off, rfkill override, firmware file replacement or persistent write.
    timeout -k 1 5 btmgmt --timeout 4 --index "$idx" public-addr "$addr" </dev/null >/dev/null 2>&1 || {
        log 'public address command failed'; return 1;
    }
    # Success is asynchronous: wait for normal MGMT info with the supplied address.
    for attempt in {1..6}; do
        if info=$(timeout -k 1 3 btmgmt --timeout 2 --index "$idx" info </dev/null 2>&1) &&
           grep -qiE "^[[:space:]]*addr ${addr}[[:space:]]" <<<"$info"; then
            log 'controller configured with operator address'
            return 0
        fi
        [[ $attempt == 6 ]] || sleep 1
    done
    log 'controller did not become ready after address command'
    return 1
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
