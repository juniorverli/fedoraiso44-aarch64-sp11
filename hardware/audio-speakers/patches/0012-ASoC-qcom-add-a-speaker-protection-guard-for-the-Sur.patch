From 57b8647d57063f55d6579a2fd1dbb34655563361 Mon Sep 17 00:00:00 2001
From: t <t@t>
Date: Fri, 30 Oct 2026 23:10:17 +0000
Subject: [PATCH 12/16] ASoC: qcom: add a speaker protection guard for the
 Surface Pro 11

The Surface Pro 11 speakers are protected by a closed loop in the DSP
(speaker protection module fed by voltage and current sense). Speaker
playback must be refused unless that loop is up.

Add a small module, "sp11", that keeps the state of the loop: the graph
with its control links, the sense capture streams, the R0/T0 calibration
and a latched fault. The producers are in-kernel only; there is no sysfs,
ioctl or mixer control that changes the state, and a fault stays latched
until reboot. A boot parameter, sp11.nospk, disables speaker playback
permanently, and sp11.allow_nominal accepts a calibration that was not
measured. The module parameters are read-only. The state is readable in
debugfs.

Assisted-by: Claude Sonnet 5.5
---
 include/sound/sp11-guard.h  |  53 ++++++++
 sound/soc/qcom/Kconfig      |   9 ++
 sound/soc/qcom/Makefile     |   2 +
 sound/soc/qcom/sp11-guard.c | 248 ++++++++++++++++++++++++++++++++++++
 4 files changed, 312 insertions(+)
 create mode 100644 include/sound/sp11-guard.h
 create mode 100644 sound/soc/qcom/sp11-guard.c

diff --git a/include/sound/sp11-guard.h b/include/sound/sp11-guard.h
new file mode 100644
index 000000000..204172a4a
--- /dev/null
+++ b/include/sound/sp11-guard.h
@@ -0,0 +1,53 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Speaker protection guard for the Surface Pro 11 (microsoft,denali).
+ *
+ * One kernel-side object decides whether the WSA884x speakers may play.
+ * The state is written only by in-kernel producers (the AudioReach core, the
+ * WSA884x codec) and read by the machine driver. There is no sysfs, ioctl or
+ * mixer path that sets it, and a fault latches until reboot.
+ */
+#ifndef __SOUND_SP11_GUARD_H
+#define __SOUND_SP11_GUARD_H
+
+#include <linux/errno.h>
+#include <linux/types.h>
+
+struct device;
+
+enum sp11_guard_stream {
+	SP11_STREAM_VI,
+	SP11_STREAM_CPS,
+	SP11_STREAM_MAX,
+};
+
+/* Speaker channels that need a calibration (left and right) */
+#define SP11_CAL_ALL_MASK	0x3
+
+#if IS_REACHABLE(CONFIG_SND_SOC_SP11_GUARD)
+/* Producers */
+void sp11_guard_graph(bool up, bool cps_required);
+void sp11_guard_stream(enum sp11_guard_stream stream, bool start);
+void sp11_guard_calibrated(unsigned int ch_mask, bool nominal);
+void sp11_guard_fault(const char *src, u32 code);
+void sp11_guard_set_mute(void (*mute)(void *data), void *data);
+void sp11_guard_clear_mute(void *data);
+
+/* Consumers */
+int sp11_guard_check(struct device *dev);
+bool sp11_guard_faulted(void);
+bool sp11_guard_nospk(void);
+#else
+static inline void sp11_guard_graph(bool up, bool cps_required) { }
+static inline void sp11_guard_stream(enum sp11_guard_stream stream, bool start) { }
+static inline void sp11_guard_calibrated(unsigned int ch_mask, bool nominal) { }
+static inline void sp11_guard_fault(const char *src, u32 code) { }
+static inline void sp11_guard_set_mute(void (*mute)(void *data), void *data) { }
+static inline void sp11_guard_clear_mute(void *data) { }
+static inline bool sp11_guard_faulted(void) { return true; }
+static inline bool sp11_guard_nospk(void) { return true; }
+/* Without the guard the speakers are never allowed */
+static inline int sp11_guard_check(struct device *dev) { return -EOPNOTSUPP; }
+#endif
+
+#endif /* __SOUND_SP11_GUARD_H */
