From 505435e95455274d377c28ab9a87947ad8654d05 Mon Sep 17 00:00:00 2001
From: Junior Mverli <25966843+juniorverli@users.noreply.github.com>
Date: Fri, 30 Oct 2026 22:01:15 +0000
Subject: [PATCH 6/9] ASoC: qcom: q6apm: ignore GPR responses until the driver
 data is published

q6apm and q6prm fetch their private data in the GPR response callback
with dev_get_drvdata(). The next patch lets the GPR bus deliver
responses while the client probe is still running, so the callbacks can
run before the probe has stored that data.

Store the q6apm data only after the fields the callback uses are
initialized, and let both callbacks ignore a packet that arrives while
the data is still missing.

Assisted-by: Claude Sonnet 5.5
---
 sound/soc/qcom/qdsp6/q6apm.c | 7 +++++--
 sound/soc/qcom/qdsp6/q6prm.c | 3 +++
 2 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/sound/soc/qcom/qdsp6/q6apm.c b/sound/soc/qcom/qdsp6/q6apm.c
index f167b9dae..09f1bf5c2 100644
--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -866,8 +866,6 @@ static int apm_probe(gpr_device_t *gdev)
 	if (!apm)
 		return -ENOMEM;
 
-	dev_set_drvdata(dev, apm);
-
 	mutex_init(&apm->lock);
 	apm->dev = dev;
 	apm->gdev = gdev;
@@ -881,6 +879,8 @@ static int apm_probe(gpr_device_t *gdev)
 
 	idr_init(&apm->modules_idr);
 
+	/* Publish the state only when the response callback can use it */
+	dev_set_drvdata(dev, apm);
 	g_apm = apm;
 
 	q6apm_get_apm_state(apm);
@@ -924,6 +924,9 @@ static int apm_callback(const struct gpr_resp_pkt *data, void *priv, int op)
 	const struct gpr_hdr *hdr = &data->hdr;
 	int graph_id, is_pos_buf;
 
+	if (!apm)
+		return 0;
+
 	result = data->payload;
 
 	switch (hdr->opcode) {
diff --git a/sound/soc/qcom/qdsp6/q6prm.c b/sound/soc/qcom/qdsp6/q6prm.c
index 1f3ce4cc0..bcc73127d 100644
--- a/sound/soc/qcom/qdsp6/q6prm.c
+++ b/sound/soc/qcom/qdsp6/q6prm.c
@@ -192,6 +192,9 @@ static int prm_callback(const struct gpr_resp_pkt *data, void *priv, int op)
 	const struct gpr_ibasic_rsp_result_t *result;
 	const struct gpr_hdr *hdr = &data->hdr;
 
+	if (!prm)
+		return 0;
+
 	switch (hdr->opcode) {
 	case PRM_CMD_RSP_REQUEST_HW_RSC:
 	case PRM_CMD_RSP_RELEASE_HW_RSC:
