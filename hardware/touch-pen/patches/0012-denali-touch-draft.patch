Subject: [PATCH RFC] arm64: dts: qcom: denali-lcd: draft disabled touch nodes

Describe MSHW0484's captured ACPI resources. Keep the controller, supply
and HID child disabled. This draft depends on the MSHW0484 binding and
sequencing RFC; quad GENI/GPI and transport support remain
unimplemented.

BSRC_QSPI.bin SHA-256:
b06b6f0a26652f1187bc12e347c53e8a51ef25c47b82cd403c9b73f64e48d11a SP11 D0
packages 0x5d32/0x5d8f identify GPIO49/50 with mux selector 2. The
X1E80100 TLMM function table independently maps that selector to SE2. Do
not infer electrical settings or enable the device from this draft.

SSDT SHA-256
95ee103a7ad5d9b55cc84ff09065171d638b6de9d1aafcde6efc69ce6a824f1b:
resources at line 1564, sequencing at 1726. DSDT SHA-256
8a7b849b9ac2148a9806d967612eb0d5195020c3e29ffd834b837767256a8ede:
controller at line 51534. Independent Claude cross-check is outstanding.

Assisted-by: Codex gpt-6.1-sol
---
diff --git a/arch/arm64/boot/dts/qcom/x1p64100-microsoft-denali.dts b/arch/arm64/boot/dts/qcom/x1p64100-microsoft-denali.dts
--- a/arch/arm64/boot/dts/qcom/x1p64100-microsoft-denali.dts
+++ b/arch/arm64/boot/dts/qcom/x1p64100-microsoft-denali.dts
@@ -13,3 +13,62 @@
 	compatible = "microsoft,denali-lcd", "microsoft,denali",
 		     "qcom,x1p64100", "qcom,x1e80100";
 };
+
+/ {
+	touch_vdd: regulator-touch-vdd {
+		compatible = "regulator-fixed";
+		regulator-name = "touch-vdd";
+		gpio = <&tlmm 64 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <500000>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&touch_vdd_default>;
+		status = "disabled";
+	};
+};
+
+&spi10 {
+	pinctrl-0 = <&qup_spi10_data_clk>, <&qup_spi10_data23>,
+		    <&qup_spi10_cs>;
+	status = "disabled";
+
+	touchscreen: hid@0 {
+		compatible = "microsoft,mshw0484";
+		reg = <0>;
+		spi-max-frequency = <40000000>;
+		spi-rx-bus-width = <4>;
+		spi-tx-bus-width = <4>;
+		interrupts-extended = <&tlmm 51 IRQ_TYPE_EDGE_FALLING>;
+		reset-gpios = <&tlmm 48 GPIO_ACTIVE_LOW>;
+		vdd-supply = <&touch_vdd>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&touch_irq_default>, <&touch_reset_default>;
+		status = "disabled";
+	};
+};
+
+&tlmm {
+	qup_spi10_data23: qup-spi10-data23-state {
+		pins = "gpio49", "gpio50";
+		function = "qup1_se2";
+		/* Pull/drive translation still needs independent cross-check. */
+	};
+
+	touch_irq_default: touch-irq-default-state {
+		pins = "gpio51";
+		function = "gpio";
+		bias-disable;
+	};
+
+	touch_reset_default: touch-reset-default-state {
+		pins = "gpio48";
+		function = "gpio";
+		bias-disable;
+	};
+
+	touch_vdd_default: touch-vdd-default-state {
+		pins = "gpio64";
+		function = "gpio";
+		bias-disable;
+	};
+};
