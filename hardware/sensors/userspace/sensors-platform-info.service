[Unit]
Description=Publish SoC identity files for hexagonrpcd (SP11 sensors, private image)
DefaultDependencies=no
Before=hexagonrpcd-sensors.service
ConditionPathExists=/usr/share/qcom/x1e80100/Microsoft/Surface-Pro-11/sensors/platform

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'mkdir -p /run/sensors-platform && cp /usr/share/qcom/x1e80100/Microsoft/Surface-Pro-11/sensors/platform/* /run/sensors-platform/'

[Install]
WantedBy=sysinit.target
