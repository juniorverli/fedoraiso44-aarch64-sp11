+/*
+ * Translate a C stdio mode string to open(2) flags. Returns -1 for an
+ * unknown mode. Text/binary markers ('b', 't') are ignored.
+ */
+static int apps_std_mode_to_flags(const char *mode)
+{
+	bool plus = strchr(mode, '+') != NULL;
+
+	switch (mode[0]) {
+	case 'r':
+		return plus ? O_RDWR : O_RDONLY;
+	case 'w':
+		return (plus ? O_RDWR : O_WRONLY) | O_CREAT | O_TRUNC;
+	case 'a':
+		return (plus ? O_RDWR : O_WRONLY) | O_CREAT | O_APPEND;
+	default:
+		return -1;
+	}
+}
+
+static uint32_t apps_std_fopen(void *data,
+			       const struct fastrpc_io_buffer *inbufs,
+			       struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	uint32_t *out = outbufs[0].p;
+	int flags, fd;
+
+	if (inbufs[1].s == 0 || ((const char *) inbufs[1].p)[inbufs[1].s - 1] != 0
+	 || inbufs[2].s == 0 || ((const char *) inbufs[2].p)[inbufs[2].s - 1] != 0)
+		return AEE_EBADPARM;
+
+	flags = apps_std_mode_to_flags(inbufs[2].p);
+	if (flags < 0)
+		return AEE_EBADPARM;
+
+	fd = hexagonfs_openat_flags(ctx->fds, ctx->rootfd, ctx->rootfd,
+				    inbufs[1].p, flags);
+	if (fd < 0) {
+		fprintf(stderr, "Could not fopen %s (%s): %s\n",
+				(const char *) inbufs[1].p,
+				(const char *) inbufs[2].p, strerror(-fd));
+		return AEE_EFAILED;
+	}
+
+#ifdef HEXAGONRPC_VERBOSE
+	printf("fopen(%s, %s) -> %d\n", (const char *) inbufs[1].p,
+				       (const char *) inbufs[2].p, fd);
+#endif
+
+	*out = fd;
+
+	return 0;
+}
+
+static uint32_t apps_std_fwrite(void *data,
+				const struct fastrpc_io_buffer *inbufs,
+				struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	const struct {
+		uint32_t fd;
+		uint32_t buf_size;
+	} *first_in = inbufs[0].p;
+	struct {
+		uint32_t written;
+		uint32_t is_eof;
+	} *first_out = outbufs[0].p;
+	ssize_t ret;
+
+	ret = hexagonfs_write(ctx->fds, first_in->fd, inbufs[1].s, inbufs[1].p);
+	if (ret < 0) {
+		fprintf(stderr, "Could not write file: %s\n", strerror(-ret));
+		return AEE_EFAILED;
+	}
+
+#ifdef HEXAGONRPC_VERBOSE
+	printf("write(%u, %zu) -> %ld\n", first_in->fd, inbufs[1].s, ret);
+#endif
+
+	first_out->written = ret;
+	first_out->is_eof = 0;
+
+	return 0;
+}
+
+/* Writes are not buffered here (write(2)), so fsync(2) is not needed. */
+static uint32_t apps_std_fsync(void *data,
+			       const struct fastrpc_io_buffer *inbufs,
+			       struct fastrpc_io_buffer *outbufs)
+{
+	return 0;
+}
+
+/*
+ * Method 24. The SNS framework removes temporary files while it rewrites the
+ * registry; a stub that reports success avoids the crash seen with the stock
+ * daemon. Nothing is deleted: a stale temporary file is harmless and the
+ * served tree stays under the packager's control.
+ */
+static uint32_t apps_std_fremove(void *data,
+				 const struct fastrpc_io_buffer *inbufs,
+				 struct fastrpc_io_buffer *outbufs)
+{
+#ifdef HEXAGONRPC_VERBOSE
+	printf("ignore fremove(%s)\n", (const char *) inbufs[1].p);
+#endif
+
+	return 0;
+}
