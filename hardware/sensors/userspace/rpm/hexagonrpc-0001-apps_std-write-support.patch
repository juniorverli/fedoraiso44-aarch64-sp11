+/* Create, write, reopen and read back a file through the path-walking API. */
+static int test_mapped_write(void)
+{
+	struct hexagonfs_fd *fds[HEXAGONFS_MAX_FD] = { NULL };
+	struct hexagonfs_dirent root = {
+		.name = "/",
+		.ops = &hexagonfs_mapped_ops,
+	};
+	char tmpl[] = "/tmp/hexagonfs-test-XXXXXX";
+	char path[sizeof(tmpl) + 16];
+	char buf[8] = { 0 };
+	int rootfd, fd;
+	int rc = 1;
+
+	if (mkdtemp(tmpl) == NULL)
+		return 1;
+
+	root.u.phys = tmpl;
+	rootfd = hexagonfs_open_root(fds, &root);
+	if (rootfd < 0)
+		goto out;
+
+	fd = hexagonfs_openat_flags(fds, rootfd, rootfd, "/reg.bin",
+				    O_WRONLY | O_CREAT | O_TRUNC);
+	if (fd < 0)
+		goto out;
+	if (hexagonfs_write(fds, fd, 5, "hello") != 5)
+		goto out;
+	hexagonfs_close(fds, fd);
+
+	fd = hexagonfs_openat(fds, rootfd, rootfd, "/reg.bin");
+	if (fd < 0)
+		goto out;
+	if (hexagonfs_read(fds, fd, 5, buf) != 5 || strcmp(buf, "hello"))
+		goto out;
+	/* a read-only descriptor must refuse a write */
+	if (hexagonfs_write(fds, fd, 1, "x") >= 0)
+		goto out;
+	hexagonfs_close(fds, fd);
+	hexagonfs_close(fds, rootfd);
+	rc = 0;
+out:
+	snprintf(path, sizeof(path), "%s/reg.bin", tmpl);
+	unlink(path);
+	rmdir(tmpl);
+	return rc;
+}
