# Private image only. Requires a hexagonrpcd build (not in Fedora 44) and the staged tree from sp11-sensors-stage.sh.
# Do not enable together with Fedora's adsprpcd.service: both claim the ADSP listener (mask adsprpcd.service and
# adsprpcd_audiopd.service, which fastrpc-services starts from udev on /dev/fastrpc-adsp).
[Unit]
Description=Hexagon DSP sensors daemon (ADSP sensorspd, SP11)
After=sysinit.target sensors-platform-info.service
Wants=sensors-platform-info.service
ConditionPathExists=/dev/fastrpc-adsp
ConditionPathExists=/usr/share/qcom/x1e80100/Microsoft/Surface-Pro-11/sensors/sns_reg.conf

[Service]
Type=simple
ExecStart=/usr/bin/hexagonrpcd
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/usr/share/qcom/x1e80100/Microsoft/Surface-Pro-11/sensors /run/sensors-platform /tmp
DevicePolicy=closed
DeviceAllow=/dev/fastrpc-adsp rw
RestrictAddressFamilies=none
# Never stop or restart the ADSP remoteproc from a unit: the reference reports a SoC crash.

[Install]
WantedBy=sysinit.target
