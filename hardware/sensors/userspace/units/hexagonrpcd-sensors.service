# SP11 sensors: serve the ADSP sensors protection domain (sensorspd) over FastRPC.
# Shipped by the sp11-sensors package. Silent no-op on an image without the private sensor tree.
#
# Why these lines:
# - "-s" attaches to sensorspd. adsprpcd (root PD) and "adsprpcd audiopd" from fastrpc-services use other
#   protection domains of the same /dev/fastrpc-adsp node, so they are NOT masked (audio needs audiopd).
#   Unverified on the device: only a boot can show that three listeners coexist.
# - The ADSP exists when /dev/fastrpc-adsp exists (the rpmsg channel of the ADSP creates the node); nothing here
#   starts, stops or resets a remoteproc (the reference reports a SoC crash when the ADSP is stopped).
# - The tree under -R is read-only package data; the writable registry lives in the state directory and is
#   reached through <root>/sensors/registry (a symlink made by sp11-sensors-install-private).
[Unit]
Description=Hexagon RPC daemon for the ADSP sensors PD (Surface Pro 11)
Documentation=file:///usr/share/doc/sp11-sensors/README
After=dev-fastrpc\x2dadsp.device systemd-sysusers.service
BindsTo=dev-fastrpc\x2dadsp.device
ConditionFirmware=device-tree-compatible(qcom,x1e80100)
ConditionPathExists=/dev/fastrpc-adsp
ConditionPathExists=/usr/share/qcom/x1e80100/Microsoft/Surface-Pro-11/sensors/sns_reg.conf
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
User=hexagonrpcd
Group=fastrpc
StateDirectory=hexagonrpcd hexagonrpcd/registry
ExecStart=/usr/bin/hexagonrpcd -f /dev/fastrpc-adsp -d adsp -s -R /usr/share/qcom/x1e80100/Microsoft/Surface-Pro-11
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
DevicePolicy=closed
DeviceAllow=/dev/fastrpc-adsp rw

[Install]
WantedBy=multi-user.target
