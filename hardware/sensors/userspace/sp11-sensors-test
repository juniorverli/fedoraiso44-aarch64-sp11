#!/bin/bash
# SP11 sensors: opt-in, read-only health test. Reports whether each layer is up and whether data arrives;
# it prints counts and states, never raw sensor values. Changes nothing: no service is started or stopped,
# no remoteproc is touched (resetting the ADSP crashes the SoC), nothing is written outside /tmp.
# Usage: sp11-sensors-test [SECONDS]   (SECONDS of data capture per sensor, default 8)
# Exit 0 only when accelerometer and light both produced data through iio-sensor-proxy.
set -u
secs=${1:-8}
root=/usr/share/qcom/x1e80100/Microsoft/Surface-Pro-11
state=/var/lib/hexagonrpcd/registry
pass=0 fail=0
ok()   { echo "PASS  $*"; pass=$((pass+1)); }
bad()  { echo "FAIL  $*"; fail=$((fail+1)); }
note() { echo "INFO  $*"; }

echo "# 1. kernel side"
for d in /sys/class/remoteproc/remoteproc*; do
	[ -r "$d/name" ] && note "remoteproc $(cat "$d/name"): $(cat "$d/state")"
done
if [ -c /dev/fastrpc-adsp ]; then ok "/dev/fastrpc-adsp present ($(stat -c '%U:%G %a' /dev/fastrpc-adsp))"; else bad "/dev/fastrpc-adsp missing"; fi
if [ "$(stat -c %a /dev/fastrpc-adsp 2>/dev/null)" = 666 ]; then bad "/dev/fastrpc-adsp is world-writable"; fi
if command -v qrtr-lookup >/dev/null 2>&1; then
	n=$(timeout 5 qrtr-lookup 2>/dev/null | tail -n +2 | wc -l)
	note "qrtr services visible: $n"
	[ "$n" -gt 0 ] && ok "QRTR name service lists services" || bad "QRTR lists no service"
else
	note "qrtr-lookup not installed"
fi

echo "# 2. served tree (names and counts only)"
[ -s $root/sensors/sns_reg.conf ] && ok "sns_reg.conf present" || bad "sns_reg.conf missing (private tree not installed)"
note "config files: $(ls $root/sensors/config 2>/dev/null | wc -l)"
note "socinfo files: $(ls $root/socinfo 2>/dev/null | wc -l)"
note "registry files in $state: $(ls $state 2>/dev/null | wc -l) (ADSP-written state files: $(ls $state 2>/dev/null | grep -c -E '^(sns_reg_config|sns_secure_database.bin|parsed_file_list.csv)$') of 3)"

echo "# 3. daemon"
st=$(systemctl is-active hexagonrpcd-sensors.service 2>&1)
note "hexagonrpcd-sensors.service: $st (restarts: $(systemctl show -p NRestarts --value hexagonrpcd-sensors.service 2>/dev/null))"
[ "$st" = active ] && ok "hexagonrpcd running" || note "hexagonrpcd not running (the reference notes sensors can stay alive after the daemon exits)"
note "daemon log lines this boot: $(journalctl -b -u hexagonrpcd-sensors.service --no-pager 2>/dev/null | grep -c .)"
note "daemon refusals (unsupported/Could not): $(journalctl -b -u hexagonrpcd-sensors.service --no-pager 2>/dev/null | grep -c -E 'unsupported|Could not|Tried to')"

echo "# 4. libssc direct (ssccli), measurement line counts per sensor"
if command -v ssccli >/dev/null 2>&1; then
	for s in accelerometer gyroscope magnetometer light compass; do
		c=$(timeout $((secs+4)) ssccli --sensor "$s" --timeout "$secs" 2>&1 | grep -c -i -E 'measurement|reading|[0-9]')
		note "ssccli $s: $c line(s)"
	done
else
	note "ssccli not installed (libssc-tools)"
fi

echo "# 5. iio-sensor-proxy (monitor-sensor, values masked)"
note "iio-sensor-proxy.service: $(systemctl is-active iio-sensor-proxy.service 2>&1)"
if command -v monitor-sensor >/dev/null 2>&1; then
	out=$(timeout "$secs" monitor-sensor 2>&1 | sed -E 's/-?[0-9]+([.,][0-9]+)?/N/g')
	echo "$out" | sort | uniq -c | sed 's/^/      /'
	echo "$out" | grep -q -i 'has accelerometer' && ok "proxy reports an accelerometer" || bad "proxy reports no accelerometer"
	echo "$out" | grep -q -i 'orientation' && ok "orientation event or state present" || bad "no orientation output"
	echo "$out" | grep -q -i 'has ambient light' && ok "proxy reports an ambient light sensor" || bad "proxy reports no ambient light sensor"
	echo "$out" | grep -q -i 'light changed' && ok "light value changed within ${secs}s" || note "no light change event in ${secs}s (a steady room produces none; cover the sensor and retry)"
	echo "$out" | grep -q -i 'compass' && ok "compass reported" || note "no compass output"
else
	bad "monitor-sensor not installed"
fi

echo "# 6. tablet mode (SSAM tablet switch, independent of the SSC)"
python3 -I - <<'PY'
import fcntl, glob, os, struct
found = False
for d in sorted(glob.glob('/sys/class/input/input*')):
    try:
        name = open(d + '/name').read().strip()
    except OSError:
        continue
    if 'Tablet Mode Switch' not in name:
        continue
    found = True
    ev = [os.path.join('/dev/input', e) for e in os.listdir(d) if e.startswith('event')]
    state = 'unknown'
    for path in ev:
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
            buf = bytearray(8)
            fcntl.ioctl(fd, 0x8000451b | (len(buf) << 16), buf)  # EVIOCGSW(len)
            os.close(fd)
            state = 'tablet' if buf[0] & 2 else 'laptop'   # SW_TABLET_MODE = 1
        except OSError as err:
            state = 'unreadable (%s)' % err.strerror
    print('PASS  %s: %s' % (name, state))
if not found:
    print('FAIL  no tablet mode switch input device (kernel: SURFACE_AGGREGATOR_TABLET_SWITCH, Type Cover state)')
PY

echo
echo "summary: $pass pass, $fail fail"
[ "$fail" -eq 0 ]
