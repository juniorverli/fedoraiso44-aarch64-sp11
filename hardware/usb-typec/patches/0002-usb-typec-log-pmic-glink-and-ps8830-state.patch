Subject: [PATCH] usb: typec: log PMIC GLINK and PS8830 state changes

The Denali M8 collector reports an attached reverse-oriented partner,
enabled retimer supplies and an enclosure at high speed, while
both SuperSpeed root ports remain in RxDetect. Existing debug messages do
not expose successful PMIC notifications or retimer configuration.

Add dynamic debug output for received and applied orientation/mux states,
notification acknowledgements, and PS8830 reset/configuration results.
Log only state already handled by the drivers; add no register reads,
power-sequence changes or firmware operations. This is a diagnostic patch,
not a SuperSpeed fix. Enable it with the existing usbdbg entry.

Assisted-by: Codex gpt-6.1-sol
---
diff --git a/drivers/soc/qcom/pmic_glink_altmode.c b/drivers/soc/qcom/pmic_glink_altmode.c
index 13c434f8d..4d226d0a0 100644
--- a/drivers/soc/qcom/pmic_glink_altmode.c
+++ b/drivers/soc/qcom/pmic_glink_altmode.c
@@ -171,6 +171,8 @@ static int pmic_glink_altmode_request(struct pmic_glink_altmode *altmode, u32 cm
 		return -ETIMEDOUT;
 	}
 
+	dev_dbg(altmode->dev, "request: cmd=%#x arg=%u acknowledged\n", cmd, arg);
+
 	return 0;
 }
 
@@ -351,8 +353,13 @@ static void pmic_glink_altmode_worker(struct work_struct *work)
 	struct pmic_glink_altmode_port *alt_port = work_to_altmode_port(work);
 	struct pmic_glink_altmode *altmode = alt_port->altmode;
 	enum drm_connector_status conn_status;
+	int ret;
 
-	typec_switch_set(alt_port->typec_switch, alt_port->orientation);
+	ret = typec_switch_set(alt_port->typec_switch, alt_port->orientation);
+	dev_dbg(altmode->dev,
+		"apply: port=%u orientation=%u mux=%u svid=%04x switch_ret=%d\n",
+		alt_port->index, alt_port->orientation, alt_port->mux_ctrl,
+		alt_port->svid, ret);
 
 	/*
 	 * MUX_CTRL_STATE_DP4LN/USB3_DP may only be set if SVID=DP, but we need
@@ -489,6 +496,9 @@ static void pmic_glink_altmode_sc8280xp_notify(struct pmic_glink_altmode *altmod
 	alt_port->svid = svid;
 	alt_port->mux_ctrl = notify->mux_ctrl;
 
+	dev_dbg(altmode->dev, "notify: port=%u orientation=%u mux=%u svid=%04x\n",
+		port, orientation, notify->mux_ctrl, svid);
+
 	if (svid == USB_TYPEC_DP_SID) {
 		dp = &notify->extended_data.dp;
 
diff --git a/drivers/usb/typec/mux/ps883x.c b/drivers/usb/typec/mux/ps883x.c
index 64e0a61b7..f36c54ac0 100644
--- a/drivers/usb/typec/mux/ps883x.c
+++ b/drivers/usb/typec/mux/ps883x.c
@@ -138,6 +138,7 @@ static void ps883x_reset(struct ps883x_retimer *retimer)
 	if (retimer->in_reset)
 		return;
 
+	dev_dbg(&retimer->client->dev, "assert reset and disable supplies\n");
 	gpiod_set_value(retimer->reset_gpio, 1);
 	ps883x_disable_vregs(retimer);
 	retimer->in_reset = true;
@@ -149,6 +150,9 @@ static int ps883x_configure(struct ps883x_retimer *retimer, int cfg0,
 	struct device *dev = &retimer->client->dev;
 	int ret;
 
+	dev_dbg(dev, "configure: conn_status=%02x/%02x/%02x reset=%u in_reset=%u\n",
+		cfg0, cfg1, cfg2, reset, retimer->in_reset);
+
 	if (reset) {
 		ps883x_reset(retimer);
 
@@ -278,6 +282,9 @@ static int ps883x_sw_set(struct typec_switch_dev *sw,
 
 	guard(mutex)(&retimer->lock);
 
+	dev_dbg(&retimer->client->dev, "orientation: %u -> %u in_reset=%u\n",
+		retimer->orientation, orientation, retimer->in_reset);
+
 	if (retimer->orientation != orientation) {
 		retimer->orientation = orientation;
 
@@ -308,6 +315,10 @@ static int ps883x_retimer_set(struct typec_retimer *rtmr,
 
 	mutex_lock(&retimer->lock);
 	ret = ps883x_set(retimer, state);
+	dev_dbg(&retimer->client->dev,
+		"set: mode=%lu svid=%04x orientation=%u in_reset=%u ret=%d\n",
+		state->mode, state->alt ? state->alt->svid : 0,
+		retimer->orientation, retimer->in_reset, ret);
 	mutex_unlock(&retimer->lock);
 
 	if (ret)
