[Unit]
Description=Give the unconfigured Surface Pro 11 Bluetooth controller a public address
BindsTo=sys-subsystem-bluetooth-devices-hci0.device
After=sys-subsystem-bluetooth-devices-hci0.device
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/sp11-bt-address hci0
TimeoutStartSec=90
PrivateMounts=yes
UMask=0077

[Install]
WantedBy=sys-subsystem-bluetooth-devices-hci0.device
