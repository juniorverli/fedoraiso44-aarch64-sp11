[Unit]
Description=Configure Surface Pro 11 Bluetooth when a public address is available
BindsTo=sys-subsystem-bluetooth-devices-hci0.device
After=sys-subsystem-bluetooth-devices-hci0.device
After=local-fs.target
# MGMT does not need bluetoothd or D-Bus. BlueZ observes the configured index
# asynchronously; avoid blocking its startup on optional operator provisioning.

[Service]
Type=oneshot
ExecStart=/usr/libexec/sp11-bt-address hci0
TimeoutStartSec=90
PrivateMounts=yes
UMask=0077

[Install]
WantedBy=sys-subsystem-bluetooth-devices-hci0.device
