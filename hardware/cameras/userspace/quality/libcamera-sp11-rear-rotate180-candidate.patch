+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+
+namespace libcamera {
+
+/* Rotate packed RGB/BGR pixels in place without moving row padding. */
+inline bool sp11Rotate180(uint8_t *data, std::size_t length,
+			  std::size_t width, std::size_t height,
+			  std::size_t stride, std::size_t pixelBytes)
+{
+	if (!data || !width || !height || !stride ||
+	    (pixelBytes != 3 && pixelBytes != 4) ||
+	    width > stride / pixelBytes || height > length / stride)
+		return false;
+
+	auto swapPixel = [data, pixelBytes](std::size_t a, std::size_t b) {
+		for (std::size_t c = 0; c < pixelBytes; ++c)
+			std::swap(data[a + c], data[b + c]);
+	};
+	for (std::size_t y = 0; y < height / 2; ++y)
+		for (std::size_t x = 0; x < width; ++x)
+			swapPixel(y * stride + x * pixelBytes,
+				  (height - 1 - y) * stride + (width - 1 - x) * pixelBytes);
+	if (height % 2) {
+		const std::size_t row = (height / 2) * stride;
+		for (std::size_t x = 0; x < width / 2; ++x)
+			swapPixel(row + x * pixelBytes, row + (width - 1 - x) * pixelBytes);
+	}
+	return true;
+}
+
+} /* namespace libcamera */
--- /dev/null
