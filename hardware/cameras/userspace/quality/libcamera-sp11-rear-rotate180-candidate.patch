@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <cstddef>
+#include <string_view>
+
+namespace libcamera {
+
+inline bool sp11IsRearRotationCandidate(std::string_view id, std::string_view model,
+					bool mounted180)
+{
+	return id == "/base/soc@0/cci@ac15000/i2c-bus@1/camera@10" &&
+	       model == "ov13858" && mounted180;
+}
+
+inline bool sp11UseRearRotation(bool eligibleCpu, bool hasConverter,
+				std::size_t streams, unsigned int rawStreams,
+				bool requestedUpright, bool native180,
+				bool sensorTransformIdentity)
+{
+	return eligibleCpu && !hasConverter && streams == 1 && rawStreams == 0 &&
+	       requestedUpright && native180 && sensorTransformIdentity;
+}
+
+} /* namespace libcamera */
