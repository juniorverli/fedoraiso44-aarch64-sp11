From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: juniorverli <25966843+juniorverli@users.noreply.github.com>
Date: Mon, 2 Nov 2026 12:00:00 +0000
Subject: [PATCH] media: qcom: camss: use Hamoa nominal votes for C-PHY

The equivalent D-PHY bit rate is not a valid input to the legacy /4 clock
rule for X1E C-PHY. At 2.4 Gsym/s that would demand 718 MHz, above every
X1E CSIPHY and CSID rate. Use the Hamoa reference nominal votes instead:
480 MHz on the CSIPHY and both CSID clocks, 400 MHz on the PHY timer.
These are selected only on C-PHY and use the existing X1E rate tables.
Limit the nominal vote to 2.5 Gsym/s, the class covering the front mode;
faster classes need separate clock validation. Reject unknown frequency.
D-PHY retains its existing path.

The 57/25 conversion remains in the pixel-rate fallback, but is not a
clock-domain conversion. The Qualcomm 680 reference also programs the
long-packet and C-PHY packet header capture selectors on RX enable. Set
these from the RDI format and VC for C-PHY, and clear them on disable.
They capture diagnostic headers; they do not route image payloads. Fix
the reversed C-PHY data-type mask before using it. Multiple streams share
one selector, so it reflects the last configured RDI.

Link: https://lists.openwall.net/linux-kernel/2026/10/16/2163
---
diff --git a/drivers/media/platform/qcom/camss/camss-csiphy.c b/drivers/media/platform/qcom/camss/camss-csiphy.c
--- a/drivers/media/platform/qcom/camss/camss-csiphy.c
+++ b/drivers/media/platform/qcom/camss/camss-csiphy.c
@@ -147,14 +147,22 @@
 
 	link_freq = camss_get_link_freq(&csiphy->subdev.entity, bpp, num_lanes,
 					csiphy->cfg.csi2->lane_cfg.cphy);
-	link_freq = camss_get_bit_clock(link_freq,
-					csiphy->cfg.csi2->lane_cfg.cphy);
+	if (csiphy->cfg.csi2->lane_cfg.cphy) {
+		/* Faster classes need separate clock validation. */
+		if (link_freq <= 0 || link_freq > 1250000000LL) {
+			dev_err(dev, "Unsupported C-PHY link frequency: %lld\n", link_freq);
+			return -EINVAL;
+		}
+	} else if (link_freq < 0) {
+		link_freq = 0;
+	}
 
 	for (i = 0; i < csiphy->nclocks; i++) {
 		struct camss_clock *clock = &csiphy->clock[i];
 
 		if (csiphy->rate_set[i]) {
-			u64 min_rate = link_freq / 4;
+			/* Use the Hamoa nominal votes for C-PHY. */
+			u64 min_rate = csiphy->cfg.csi2->lane_cfg.cphy ? 0 : link_freq / 4;
 			long round_rate;
 
 			camss_add_clock_margin(&min_rate);
@@ -181,6 +189,8 @@
 				return -EINVAL;
 			}
 
+			if (csiphy->cfg.csi2->lane_cfg.cphy)
+				dev_dbg(dev, "CSIPHY %s rate %ld Hz\n", clock->name, round_rate);
 			csiphy->timer_clk_rate = round_rate;
 
 			ret = clk_set_rate(clock->clk, csiphy->timer_clk_rate);
diff --git a/drivers/media/platform/qcom/camss/camss-csid.c b/drivers/media/platform/qcom/camss/camss-csid.c
--- a/drivers/media/platform/qcom/camss/camss-csid.c
+++ b/drivers/media/platform/qcom/camss/camss-csid.c
@@ -548,7 +548,8 @@
 				 csid->fmt[MSM_CSIPHY_PAD_SINK].code);
 	link_freq = camss_get_link_freq(&csid->subdev.entity, fmt->bpp,
 					csid->phy.lane_cnt, csid->phy.cphy);
-	link_freq = camss_get_bit_clock(link_freq, csid->phy.cphy);
+	if (link_freq < 0)
+		link_freq = 0;
 
 	for (i = 0; i < csid->nclocks; i++) {
 		struct camss_clock *clock = &csid->clock[i];
@@ -556,8 +557,11 @@
 		if (!strcmp(clock->name, "csi0") ||
 		    !strcmp(clock->name, "csi1") ||
 		    !strcmp(clock->name, "csi2") ||
-		    !strcmp(clock->name, "csi3")) {
-			u64 min_rate = link_freq / 4;
+		    !strcmp(clock->name, "csi3") ||
+		    (csid->phy.cphy && (!strcmp(clock->name, "csid") ||
+					!strcmp(clock->name, "csid_csiphy_rx")))) {
+			/* Use the Hamoa nominal vote for C-PHY. */
+			u64 min_rate = csid->phy.cphy ? 0 : link_freq / 4;
 			long rate;
 
 			camss_add_clock_margin(&min_rate);
@@ -584,6 +588,8 @@
 				return -EINVAL;
 			}
 
+			if (csid->phy.cphy)
+				dev_dbg(dev, "CSID %s rate %ld Hz\n", clock->name, rate);
 			ret = clk_set_rate(clock->clk, rate);
 			if (ret < 0) {
 				dev_err(dev, "clk set rate failed: %d\n", ret);
diff --git a/drivers/media/platform/qcom/camss/camss-csid-680.c b/drivers/media/platform/qcom/camss/camss-csid-680.c
--- a/drivers/media/platform/qcom/camss/camss-csid-680.c
+++ b/drivers/media/platform/qcom/camss/camss-csid-680.c
@@ -122,7 +122,7 @@
 #define		CSI2_RX_CAPTURE_CTRL_LONG_PKT_DT		GENMASK(9, 4)
 #define		CSI2_RX_CAPTURE_CTRL_LONG_PKT_VC		GENMASK(14, 10)
 #define		CSI2_RX_CAPTURE_CTRL_SHORT_PKT_VC		GENMASK(19, 15)
-#define		CSI2_RX_CAPTURE_CTRL_CPHY_PKT_DT		GENMASK(20, 25)
+#define		CSI2_RX_CAPTURE_CTRL_CPHY_PKT_DT		GENMASK(25, 20)
 #define		CSI2_RX_CAPTURE_CTRL_CPHY_PKT_VC		GENMASK(30, 26)
 
 #define CSID_CSI2_RX_TOTAL_PKTS_RCVD				0x240
@@ -243,6 +243,21 @@
 	u8 dt_id;
 	u32 val;
 
+	if (csid->phy.cphy) {
+		val = 0;
+		if (enable) {
+			val = CSI2_RX_CAPTURE_CTRL_LONG_PKT_EN |
+			      CSI2_RX_CAPTURE_CTRL_CPHY_PKT_EN |
+			      FIELD_PREP(CSI2_RX_CAPTURE_CTRL_LONG_PKT_DT, format->data_type) |
+			      FIELD_PREP(CSI2_RX_CAPTURE_CTRL_LONG_PKT_VC, vc) |
+			      FIELD_PREP(CSI2_RX_CAPTURE_CTRL_CPHY_PKT_DT, format->data_type) |
+			      FIELD_PREP(CSI2_RX_CAPTURE_CTRL_CPHY_PKT_VC, vc);
+		}
+		writel(val, csid->base + CSID_CSI2_RX_CAPTURE_CTRL);
+		dev_dbg(csid->camss->dev, "CSID%d C-PHY capture control %#x\n",
+			csid->id, val);
+	}
+
 	if (!lane_cnt)
 		lane_cnt = 4;
 
diff --git a/drivers/media/platform/qcom/camss/camss.c b/drivers/media/platform/qcom/camss/camss.c
--- a/drivers/media/platform/qcom/camss/camss.c
+++ b/drivers/media/platform/qcom/camss/camss.c
@@ -4622,9 +4622,8 @@
 /*
  * A C-PHY trio carries 16 bits in 7 symbols, on average 2.2857 bits per
  * symbol. The Qualcomm CSIPHY reference tables derive the lane bit rate from
- * the symbol rate at 2.28 bits per symbol, so the same 57/25 is used for the
- * CSIPHY and CSID clock rates here, 0.25% below 16/7. The symbol rate class
- * of the CSIPHY comes from the link frequency alone and does not use this.
+ * the symbol rate at 2.28 bits per symbol, 0.25% below 16/7. This factor
+ * is used only for the pixel-rate fallback, not for hardware clock votes.
  */
 #define CAMSS_CPHY_BITS_PER_SYMBOL_NUM		57
 #define CAMSS_CPHY_BITS_PER_SYMBOL_DEN		25
@@ -4663,29 +4662,6 @@
 	}
 
 	return v4l2_get_link_freq(sensor_pad, mul, div);
-}
-
-/**
- * camss_get_bit_clock - Convert a link frequency to the equivalent D-PHY one
- * @link_freq: Link frequency as returned by camss_get_link_freq()
- * @cphy: The link is C-PHY
- *
- * The CSIPHY and CSID clock rates are derived from the bit rate of a lane.
- * On C-PHY that is the symbol rate times 2.28 bits per symbol, which is the
- * link frequency a D-PHY would need for the same bit rate.
- *
- * Return the equivalent D-PHY link frequency, or 0 if @link_freq is not valid
- */
-u64 camss_get_bit_clock(s64 link_freq, bool cphy)
-{
-	if (link_freq <= 0)
-		return 0;
-
-	if (!cphy)
-		return link_freq;
-
-	return div_u64(link_freq * CAMSS_CPHY_BITS_PER_SYMBOL_NUM,
-		       CAMSS_CPHY_BITS_PER_SYMBOL_DEN);
 }
 
 /*
diff --git a/drivers/media/platform/qcom/camss/camss.h b/drivers/media/platform/qcom/camss/camss.h
--- a/drivers/media/platform/qcom/camss/camss.h
+++ b/drivers/media/platform/qcom/camss/camss.h
@@ -170,7 +170,6 @@
 struct media_pad *camss_find_sensor_pad(struct media_entity *entity);
 s64 camss_get_link_freq(struct media_entity *entity, unsigned int bpp,
 			unsigned int lanes, bool cphy);
-u64 camss_get_bit_clock(s64 link_freq, bool cphy);
 int camss_get_pixel_clock(struct media_entity *entity, u64 *pixel_clock);
 int camss_pm_domain_on(struct camss *camss, int id);
 void camss_pm_domain_off(struct camss *camss, int id);
-- 
2.43.0
