From 0154ad1d48642c5d0e1f826d54bfb992c8f88733 Mon Sep 17 00:00:00 2001
From: Codex <codex@localhost>
Date: Sun, 1 Nov 2026 12:49:02 +0000
Subject: [PATCH] drm/msm: add opt-in GPU boot phase trace

Add default-off phase markers around lazy firmware loading, runtime
resume, GMU firmware/HFI startup, and GPU hardware initialization. Keep
markers outside the GPU mutex and make no power, clock, or firmware
behavior changes.

Signed-off-by: Codex <codex@localhost>
---
 drivers/gpu/drm/msm/Kconfig                | 11 +++++++++++
 drivers/gpu/drm/msm/adreno/a6xx_gmu.c      | 10 ++++++++++
 drivers/gpu/drm/msm/adreno/adreno_device.c | 14 ++++++++++++++
 3 files changed, 35 insertions(+)

diff --git a/drivers/gpu/drm/msm/Kconfig b/drivers/gpu/drm/msm/Kconfig
index ed1c4775d..8316a24b3 100644
--- a/drivers/gpu/drm/msm/Kconfig
+++ b/drivers/gpu/drm/msm/Kconfig
@@ -39,6 +39,17 @@ config DRM_MSM_GPU_STATE
 	depends on DRM_MSM && (DEBUG_FS || DEV_COREDUMP)
 	default y
 
+config DRM_MSM_GPU_BOOT_TRACE
+	tristate "MSM GPU boot phase trace"
+	depends on DRM_MSM
+	default n
+	help
+	  Emit low-volume phase markers around the first GPU runtime resume,
+	  GMU firmware/HFI startup and GPU hardware initialization. This is
+	  diagnostic instrumentation for controlled boot tests; it does not
+	  change power, clock, frequency or firmware behavior. Leave disabled
+	  for normal kernels.
+
 config DRM_MSM_GPU_SUDO
 	bool "Enable SUDO flag on submits"
 	depends on DRM_MSM && EXPERT
diff --git a/drivers/gpu/drm/msm/adreno/a6xx_gmu.c b/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
index 6d49c51df..5c25bdcf8 100644
--- a/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
@@ -1361,11 +1361,21 @@ int a6xx_gmu_resume(struct a6xx_gpu *a6xx_gpu)
 		status = GMU_COLD_BOOT;
 	}
 
+	if (IS_ENABLED(CONFIG_DRM_MSM_GPU_BOOT_TRACE))
+		dev_info(gmu->dev, "GPU_BOOT_TRACE GMU firmware start begin\n");
 	ret = a6xx_gmu_fw_start(gmu, status);
+	if (IS_ENABLED(CONFIG_DRM_MSM_GPU_BOOT_TRACE))
+		dev_info(gmu->dev, "GPU_BOOT_TRACE GMU firmware start returned=%d\n",
+			 ret);
 	if (ret)
 		goto disable_irq;
 
+	if (IS_ENABLED(CONFIG_DRM_MSM_GPU_BOOT_TRACE))
+		dev_info(gmu->dev, "GPU_BOOT_TRACE GMU HFI start begin\n");
 	ret = a6xx_hfi_start(gmu, status);
+	if (IS_ENABLED(CONFIG_DRM_MSM_GPU_BOOT_TRACE))
+		dev_info(gmu->dev, "GPU_BOOT_TRACE GMU HFI start returned=%d\n",
+			 ret);
 	if (ret)
 		goto disable_irq;
 
diff --git a/drivers/gpu/drm/msm/adreno/adreno_device.c b/drivers/gpu/drm/msm/adreno/adreno_device.c
index 05c77fe27..f8d00ad76 100644
--- a/drivers/gpu/drm/msm/adreno/adreno_device.c
+++ b/drivers/gpu/drm/msm/adreno/adreno_device.c
@@ -82,6 +82,8 @@ struct msm_gpu *adreno_load_gpu(struct drm_device *dev)
 	}
 
 	adreno_gpu = to_adreno_gpu(gpu);
+	if (IS_ENABLED(CONFIG_DRM_MSM_GPU_BOOT_TRACE))
+		dev_info(dev->dev, "GPU_BOOT_TRACE load begin\n");
 
 	/*
 	 * The number one reason for HW init to fail is if the firmware isn't
@@ -92,12 +94,16 @@ struct msm_gpu *adreno_load_gpu(struct drm_device *dev)
 	ret = adreno_load_fw(adreno_gpu);
 	if (ret)
 		return NULL;
+	if (IS_ENABLED(CONFIG_DRM_MSM_GPU_BOOT_TRACE))
+		dev_info(dev->dev, "GPU_BOOT_TRACE firmware ready\n");
 
 	if (gpu->funcs->ucode_load) {
 		ret = gpu->funcs->ucode_load(gpu);
 		if (ret)
 			return NULL;
 	}
+	if (IS_ENABLED(CONFIG_DRM_MSM_GPU_BOOT_TRACE))
+		dev_info(dev->dev, "GPU_BOOT_TRACE ucode ready\n");
 
 	/*
 	 * Now that we have firmware loaded, and are ready to begin
@@ -105,16 +111,24 @@ struct msm_gpu *adreno_load_gpu(struct drm_device *dev)
 	 */
 	pm_runtime_enable(&pdev->dev);
 
+	if (IS_ENABLED(CONFIG_DRM_MSM_GPU_BOOT_TRACE))
+		dev_info(dev->dev, "GPU_BOOT_TRACE runtime resume begin\n");
 	ret = pm_runtime_get_sync(&pdev->dev);
 	if (ret < 0) {
 		pm_runtime_put_noidle(&pdev->dev);
 		DRM_DEV_ERROR(dev->dev, "Couldn't power up the GPU: %d\n", ret);
 		goto err_disable_rpm;
 	}
+	if (IS_ENABLED(CONFIG_DRM_MSM_GPU_BOOT_TRACE))
+		dev_info(dev->dev, "GPU_BOOT_TRACE runtime resume returned=%d\n", ret);
 
+	if (IS_ENABLED(CONFIG_DRM_MSM_GPU_BOOT_TRACE))
+		dev_info(dev->dev, "GPU_BOOT_TRACE hw init begin\n");
 	mutex_lock(&gpu->lock);
 	ret = msm_gpu_hw_init(gpu);
 	mutex_unlock(&gpu->lock);
+	if (IS_ENABLED(CONFIG_DRM_MSM_GPU_BOOT_TRACE))
+		dev_info(dev->dev, "GPU_BOOT_TRACE hw init returned=%d\n", ret);
 	if (ret) {
 		DRM_DEV_ERROR(dev->dev, "gpu hw init failed: %d\n", ret);
 		goto err_put_rpm;
-- 
2.43.0

